#. {reason}" (lower case).
#: src/pyguibud/preview/_host.py:24
msgid "it has no preview host, so it cannot be previewed."
msgstr ""
"es hat keinen Vorschau-Host und kann daher nicht in der Vorschau "
"angezeigt werden."

#. Translators: {option} and {other} are command-line options such as "-o" and
#. "--check"; they
#. are never translated.
#: src/pyguibud/uic.py:48
#, python-brace-format
msgid "{option} cannot be used with {other}"
msgstr "{option} kann nicht zusammen mit {other} verwendet werden"

#. Translators: {option} is a command-line option ("-o"); it is never
#. translated.
#: src/pyguibud/uic.py:50
#, python-brace-format
msgid "{option} can be used with one input file only"
msgstr "{option} kann nur mit einer Eingabedatei verwendet werden"

#: src/pyguibud/uic.py:58
msgid ""
"Check PyGUIbud .ui files, generate Python code from them and extract "
"their texts for translation."
msgstr ""
"PyGUIbud-.ui-Dateien prüfen, daraus Python-Code generieren und ihre Texte"
" zur Übersetzung extrahieren."

#. Translators: {group} is the name of a Python entry-point group; it is never
#. translated.
#: src/pyguibud/uic.py:63
#, python-brace-format
msgid ""
"The check loads the installed widget plugins (entry point {group}), which"
" runs their code; only check files with plugins you trust."
msgstr ""
"Die Prüfung lädt die installierten Widget-Plugins (Einstiegspunkt "
"{group}) und führt dabei deren Code aus; prüfen Sie nur Dateien mit "
"Plugins, denen Sie vertrauen."

#: src/pyguibud/uic.py:84
msgid "read and validate each file and report errors and warnings"
msgstr "jede Datei lesen und validieren und Fehler und Warnungen melden"

#: src/pyguibud/uic.py:89
msgid ""
"write a translation template (.pot) with the translatable texts of the "
"files"
msgstr ""
"eine Übersetzungsvorlage (.pot) mit den übersetzbaren Texten der Dateien "
"schreiben"

#. Translators: {pattern} is a file name pattern and {extract} a command-line
#. option; both
#. are never translated.
#: src/pyguibud/uic.py:99
#, python-brace-format
msgid ""
"output file (generate: default {pattern} next to the .ui file; {extract}:"
" default standard output)"
msgstr ""
"Ausgabedatei (beim Generieren: Standard {pattern} neben der .ui-Datei; "
"{extract}: Standard ist die Standardausgabe)"

#. Translators: {program} is the name of this command; it is never translated.
#: src/pyguibud/uic.py:108
#, python-brace-format
msgid ""
"replace an output file even if {program} did not generate it, and "
"generate code from images and includes outside the folder of the .ui file"
msgstr ""
"eine Ausgabedatei auch dann ersetzen, wenn {program} sie nicht generiert "
"hat, und Code aus Bildern und Einbindungen außerhalb des Ordners der .ui-"
"Datei generieren"

#: src/pyguibud/uic.py:112
msgid ".ui file to process"
msgstr "zu verarbeitende .ui-Datei"

#. Translators: {path} is a file name as typed by the user.
#: src/pyguibud/uic.py:156
#, python-brace-format
msgid "{path}: no errors found"
msgstr "{path}: keine Fehler gefunden"

#. Translators: {path} is the .ui file, {output} the Python file written from
#. it.
#: src/pyguibud/uic.py:202
#, python-brace-format
msgid "{path}: wrote {output}"
msgstr "{path}: {output} geschrieben"

#. Translators: {output} is the translation template (.pot) that was written.
#: src/pyguibud/uic.py:244
#, python-brace-format
msgid "wrote {output}"
msgstr "{output} geschrieben"

#: src/pyguibud/uic.py:283
msgid "no file matches this pattern"
msgstr "keine Datei entspricht diesem Muster"


#. name.
#: src/pyguibud_runtime/_load.py:44
#, python-brace-format
msgid "{count} error prevents loading '{path}'."
msgid_plural "{count} errors prevent loading '{path}'."
msgstr[0] "{count} Fehler verhindert das Laden von '{path}'."
msgstr[1] "{count} Fehler verhindern das Laden von '{path}'."

#. Translators: {argument} is the name of a Python argument ("master="); keep
#. it unchanged.
#: src/pyguibud_runtime/_load.py:47
#, python-brace-format
msgid "'{path}' has no main window; pass {argument} to load its dialogs."
msgstr ""
"'{path}' enthält kein Hauptfenster; übergeben Sie {argument}, um seine "
"Dialoge zu laden."

#: src/pyguibud_runtime/_load.py:48
#, python-brace-format
msgid "'{path}' contains only components; include them from another .ui file."
msgstr ""
"'{path}' enthält nur Komponenten; binden Sie sie aus einer anderen .ui-"
"Datei ein."

#. Translators: {target} is the handlers object (its type name), {names} a
#. comma-separated list.
#: src/pyguibud_runtime/_load.py:51
#, python-brace-format
msgid "{count} handler is missing or not callable on {target}: {names}."
msgid_plural "{count} handlers are missing or not callable on {target}: {names}."
msgstr[0] ""
"{count} Ereignisbehandlung fehlt oder ist für {target} nicht aufrufbar: "
"{names}."

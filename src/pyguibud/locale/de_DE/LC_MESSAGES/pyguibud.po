#. Translators: {namespace} is the XML namespace URI of PyGUIbud files.
#: src/pyguibud/core/xml_io.py:218
#, python-brace-format
msgid ""
"This is not a PyGUIbud .ui file: the root element must be <pyguibud-ui> "
"in the namespace {namespace}."
msgstr ""
"Dies ist keine PyGUIbud-.ui-Datei: Das Wurzelelement muss <pyguibud-ui> "
"im Namespace {namespace} sein."

#. Translators: {limit} is a whole number of mebibytes.
#: src/pyguibud/core/xml_io.py:230 src/pyguibud/core/xml_io.py:1134
#, python-brace-format
msgid "The file is larger than the limit of {limit} MiB for .ui files."
msgstr "Die Datei überschreitet das Limit von {limit} MiB für .ui-Dateien."

#. Translators: {element} is an XML element name, {attribute} an attribute
#. name.
#: src/pyguibud/core/xml_io.py:266 src/pyguibud/core/xml_io.py:519
#, python-brace-format
msgid "The element <{element}> needs the attribute '{attribute}'."
msgstr "Das Element <{element}> benötigt das Attribut '{attribute}'."

#. Translators: {version} is the text found in the file; keep MAJOR.MINOR as it
#. is.
#: src/pyguibud/core/xml_io.py:278
#, python-brace-format
msgid ""
"'{version}' is not a valid schema version; expected MAJOR.MINOR, for "
"example 1.0."
msgstr ""
"'{version}' ist keine gültige Schemaversion; erwartet wird MAJOR.MINOR, "
"zum Beispiel 1.0."

#. Translators: {version} and {current} are schema versions such as 2.0 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:290
#, python-brace-format
msgid ""
"This file uses schema version {version}; it needs a newer PyGUIbud (this "
"one supports {current})."
msgstr ""
"Diese Datei verwendet Schemaversion {version}; sie benötigt eine neuere "
"PyGUIbud-Version (diese unterstützt {current})."

#. Translators: {version} and {current} are schema versions such as 1.1 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:308
#, python-brace-format
msgid ""
"This file uses schema version {version}, newer than {current}; it is "
"opened read-only so that nothing is lost."
msgstr ""
"Diese Datei verwendet Schemaversion {version}, neuer als {current}; sie "
"wird schreibgeschützt geöffnet, damit nichts verloren geht."

#. Translators: {version} and {current} are schema versions such as 0.9 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:324
#, python-brace-format
msgid ""
"The file was upgraded from schema version {version} to {current}; saving "
"writes the new version."
msgstr ""
"Die Datei wurde von Schemaversion {version} auf {current} aktualisiert; "
"beim Speichern wird die neue Version geschrieben."

#. Translators: {prefix} is an XML namespace prefix such as tb; {uri} is the
#. namespace it is bound to in the file. Keep both unchanged.
#: src/pyguibud/core/xml_io.py:342
#, python-brace-format
msgid ""
"The prefix '{prefix}' is bound to the foreign namespace '{uri}'; this "
"content is not for ttkbootstrap and is saved under another prefix."
msgstr ""
"Das Präfix '{prefix}' ist an den fremden Namensraum '{uri}' gebunden; "
"dieser Inhalt ist nicht für ttkbootstrap bestimmt und wird unter einem "
"anderen Präfix gespeichert."

#. Translators: {count} is a number of XML comments and processing
#. instructions.
#: src/pyguibud/core/xml_io.py:359
#, python-brace-format
msgid ""
"Comments and processing instructions ({count}) are not kept when the file"
" is saved."
msgstr ""
"Kommentare und Verarbeitungsanweisungen ({count}) werden beim Speichern "
"der Datei nicht beibehalten."

#. Translators: {element} is an XML element name.
#: src/pyguibud/core/xml_io.py:421
#, python-brace-format
msgid "Text is not allowed directly inside <{element}>."
msgstr "Text ist direkt innerhalb von <{element}> nicht zulässig."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:442
#, python-brace-format
msgid ""
"Unknown element <{element}> inside <{parent}> is kept as it is; check its"
" spelling."
msgstr ""
"Das unbekannte Element <{element}> innerhalb von <{parent}> bleibt "
"unverändert erhalten; prüfen Sie die Schreibweise."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:455
#, python-brace-format
msgid "<{element}> is not allowed inside <{parent}>."
msgstr "<{element}> ist innerhalb von <{parent}> nicht zulässig."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:464
#, python-brace-format
msgid ""
"<{element}> inside <{parent}> belongs to a newer schema and is kept as it"
" is."
msgstr ""
"<{element}> innerhalb von <{parent}> gehört zu einem neueren Schema und "
"bleibt unverändert erhalten."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:481
#, python-brace-format
msgid "<{element}> appears more than once inside <{parent}>."
msgstr "<{element}> kommt innerhalb von <{parent}> mehrfach vor."

#. Translators: {attribute} is an XML attribute name, {element} an element.
#: src/pyguibud/core/xml_io.py:504
#, python-brace-format
msgid ""
"Unknown attribute '{attribute}' on <{element}> is kept as it is; check "
"its spelling."
msgstr ""
"Das unbekannte Attribut '{attribute}' bei <{element}> bleibt unverändert "
"erhalten; prüfen Sie die Schreibweise."

#. Translators: {attribute} is an attribute name, {element} an element name and
#. {value} the text found in the file.
#: src/pyguibud/core/xml_io.py:533
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be a whole number, not "
"'{value}'."
msgstr ""
"Das Attribut '{attribute}' von <{element}> muss eine ganze Zahl sein, "
"nicht '{value}'."

#. Translators: {attribute} is an attribute name, {element} an element name and
#. {value} the text found in the file; keep true and false untranslated.
#: src/pyguibud/core/xml_io.py:570
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be true or false, not "
"'{value}'."
msgstr ""
"Das Attribut '{attribute}' von <{element}> muss true oder false sein, "
"nicht '{value}'."

#. Translators: {attribute} is an attribute name, {element} an element name,
#. {choices} a comma-separated list of allowed values and {value} the text
#. found.
#: src/pyguibud/core/xml_io.py:600
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be one of {choices}, not "
"'{value}'."
msgstr ""
"Das Attribut '{attribute}' von <{element}> muss einer der Werte {choices}"
" sein, nicht '{value}'."

#. Translators: {id} is an identifier from the file.
#: src/pyguibud/core/xml_io.py:671
#, python-brace-format
msgid "The resource id '{id}' is declared more than once."
msgstr "Die Ressourcen-ID '{id}' wird mehrfach deklariert."

#. Translators: {id} is an identifier from the file.
#: src/pyguibud/core/xml_io.py:700
#, python-brace-format
msgid "The variable id '{id}' is declared more than once."
msgstr "Die Variablen-ID '{id}' wird mehrfach deklariert."

#. Translators: {name} is a property name.
#: src/pyguibud/core/xml_io.py:723
#, python-brace-format
msgid "The property '{name}' must contain plain text only, not elements."
msgstr "Die Eigenschaft '{name}' darf nur reinen Text enthalten, keine Elemente."

#. Translators: {name} is a property name, {element} an XML element name.
#: src/pyguibud/core/xml_io.py:750
#, python-brace-format
msgid "The property '{name}' is set more than once on <{element}>."
msgstr "Die Eigenschaft '{name}' wird bei <{element}> mehrfach festgelegt."

#. Translators: {element} is an XML element name; keep <cell>, <pack> and
#. <page>.
#: src/pyguibud/core/xml_io.py:950
#, python-brace-format
msgid "<{element}> has more than one placement (<cell>, <pack> or <page>)."
msgstr "<{element}> hat mehr als eine Platzierung (<cell>, <pack> oder <page>)."

#. Translators: {name} is a property name; keep 'text' untranslated.
#: src/pyguibud/core/xml_io.py:1001
#, python-brace-format
msgid "A <page> can only hold the property 'text', not '{name}'."
msgstr "Ein <page> kann nur die Eigenschaft 'text' enthalten, nicht '{name}'."

#. Translators: {reason} is an error description from the operating system.
#: src/pyguibud/core/xml_io.py:1071
#, python-brace-format
msgid "The file could not be saved: {reason}"
msgstr "Die Datei konnte nicht gespeichert werden: {reason}"

#. Translators: {version} and {current} are schema versions such as 1.1 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:1108
#, python-brace-format
msgid ""
"This document uses schema version {version}, newer than {current}; it was"
" opened read-only and cannot be saved."
msgstr ""
"Dieses Dokument verwendet Schemaversion {version}, neuer als {current}; "
"es wurde schreibgeschützt geöffnet und kann nicht gespeichert werden."

#. Translators: {version} is the version stored in the document, {current} the
#. version this PyGUIbud writes.
#: src/pyguibud/core/xml_io.py:1120
#, python-brace-format
msgid ""
"The document's schema version '{version}' cannot be saved; expected "
"{current}."
msgstr ""
"Die Schemaversion '{version}' des Dokuments kann nicht gespeichert "
"werden; erwartet wird {current}."

#. Translators: {where} is a technical path such as window[main]@kind; {value}
#. is
#. the offending value.
#: src/pyguibud/core/xml_io.py:1155
#, python-brace-format
msgid "{where} has the value '{value}', which the .ui format cannot store."
msgstr "{where} hat den Wert '{value}', den das .ui-Format nicht speichern kann."

#. Translators: {where} is a technical path; {key} and {name} are identifiers.
#: src/pyguibud/core/xml_io.py:1199
#, python-brace-format
msgid "{where}: the key '{key}' does not match the name '{name}'."
msgstr ""
"{where}: Der Schlüssel '{key}' stimmt nicht mit dem Namen '{name}' "
"überein."

#. Translators: {limit} is a number of nesting levels.
#: src/pyguibud/core/xml_io.py:1219 src/pyguibud/core/xml_io.py:1265
#: src/pyguibud/core/xmltree.py:263
#, python-brace-format
msgid "Elements are nested more than {limit} levels deep."
msgstr "Elemente sind mehr als {limit} Ebenen tief verschachtelt."

#. Translators: {name} is an XML attribute name; {where} is a technical path.
#: src/pyguibud/core/xml_io.py:1232 src/pyguibud/core/xmltree.py:152
#, python-brace-format
msgid "'{name}' is not a valid attribute name here ({where})."
msgstr "'{name}' ist hier kein gültiger Attributname ({where})."

#: src/pyguibud/core/xml_io.py:1247
msgid "RawXml.extra_attrs must be empty"
msgstr "RawXml.extra_attrs muss leer sein"

#. Translators: {element} is an XML element name.
#: src/pyguibud/core/xml_io.py:1258
#, python-brace-format
msgid "<{element}> is a .ui element and cannot be kept as preserved XML"
msgstr ""
"<{element}> ist ein .ui-Element und kann nicht als erhaltenes XML "
"beibehalten werden"

#. Translators: {where} is a technical path; {detail} explains the damage.
#: src/pyguibud/core/xml_io.py:1274 src/pyguibud/core/xmltree.py:383
#, python-brace-format
msgid "Preserved XML content of {where} is damaged: {detail}"
msgstr "Der erhaltene XML-Inhalt von {where} ist beschädigt: {detail}"

#. Translators: {where} is a technical path such as
#. window[main]/widget[btn]@text;
#. {codepoint} is a hexadecimal character code such as 0001.
#: src/pyguibud/core/xmltree.py:141
#, python-brace-format
msgid "{where} contains the character U+{codepoint}, which XML cannot store."
msgstr "{where} enthält das Zeichen U+{codepoint}, das XML nicht speichern kann."

#. Translators: {prefix} is an XML namespace prefix, {uri} its namespace URI.
#: src/pyguibud/core/xmltree.py:186
#, python-brace-format
msgid "The namespace declaration '{prefix}' = '{uri}' is not valid."
msgstr "Die Namespace-Deklaration '{prefix}' = '{uri}' ist ungültig."

#. Translators: {element} is an XML element name; {attribute} is the literal
#. XML
#. attribute to remove; keep it unchanged.
#: src/pyguibud/core/xmltree.py:281
#, python-brace-format
msgid ""
"The element <{element}> has no namespace; remove {attribute} from the "
"file."
msgstr ""
"Das Element <{element}> hat keinen Namespace; entfernen Sie {attribute} "
"aus der Datei."

#. Translators: {encoding} is an encoding name such as ISO-8859-1.
#: src/pyguibud/core/xmltree.py:328
#, python-brace-format
msgid "The file declares the encoding '{encoding}'; only UTF-8 is supported."
msgstr ""
"Die Datei deklariert die Kodierung '{encoding}'; es wird nur UTF-8 "
"unterstützt."

#: src/pyguibud/core/xmltree.py:335
msgid "DOCTYPE and entity declarations are not allowed in .ui files."
msgstr "DOCTYPE- und Entitätsdeklarationen sind in .ui-Dateien nicht zulässig."

#. Translators: {detail} is an English description from the XML parser.
#: src/pyguibud/core/xmltree.py:345 src/pyguibud/core/xmltree.py:354
#, python-brace-format
msgid "The file is not well-formed XML: {detail}"
msgstr "Die Datei ist kein wohlgeformtes XML: {detail}"

#: src/pyguibud/core/xmltree.py:399
msgid "it is not valid Unicode text"
msgstr "ungültiger Unicode-Text"

#: src/pyguibud/core/xmltree.py:405
msgid "it contains comments or processing instructions"
msgstr "enthält Kommentare oder Verarbeitungsanweisungen"

#: src/pyguibud/designer/__init__.py:16
#, python-brace-format
msgid "The designer window cannot be opened: {reason}"
msgstr "Das Designer-Fenster kann nicht geöffnet werden: {reason}"

#: src/pyguibud/designer/__init__.py:17
msgid "Install Tk for your Python (for example the python3-tk package)."
msgstr "Installieren Sie Tk für Ihr Python (zum Beispiel das Paket python3-tk)."

#: src/pyguibud/designer/actions.py:28
#, python-brace-format
msgid "The action could not be completed: {reason}"
msgstr "Die Aktion konnte nicht abgeschlossen werden: {reason}"

#. Translators: {label} is an action ("Delete"); {scope} lists the panels where
#. its key works.
#: src/pyguibud/designer/actions.py:30
#, python-brace-format
msgid "{label} ({scope})"
msgstr "{label} ({scope})"

#: src/pyguibud/designer/actions.py:31
msgid "canvas"
msgstr "Zeichenfläche"

#: src/pyguibud/designer/actions.py:31
msgid "object tree"
msgstr "Objektbaum"

#. Translators: a toolbar tooltip and hint: {action} is a menu label ("Save"),
#. {shortcut} its
#. key ("Ctrl+S").
#: src/pyguibud/designer/actions.py:34
#, python-brace-format
msgid "{action} ({shortcut})"
msgstr "{action} ({shortcut})"

#: src/pyguibud/designer/app.py:88
msgid "PyGUIbud designer"
msgstr "PyGUIbud-Designer"

#: src/pyguibud/designer/app.py:89
#, python-brace-format
msgid "There is no theme called '{theme}'."
msgstr "Es gibt kein Design namens '{theme}'."

#. Translators: {name} is a file name such as "main.ui".
#: src/pyguibud/designer/app.py:91
#, python-brace-format
msgid "Saved '{name}'."
msgstr "'{name}' gespeichert."

#. Translators: {name} is a file name such as "main.ui".
#: src/pyguibud/designer/app.py:93
#, python-brace-format
msgid "'{name}' was changed by another program since it was opened."
msgstr "'{name}' wurde seit dem Öffnen von einem anderen Programm geändert."

#. Translators: the answers when the file changed on disk; _ marks the access
#. key.
#: src/pyguibud/designer/app.py:95
msgid "_Overwrite"
msgstr "Über_schreiben"

#: src/pyguibud/designer/app.py:96 src/pyguibud/designer/standard_actions.py:97
msgid "Save _as…"
msgstr "Speichern _unter…"

#: src/pyguibud/designer/app.py:97 src/pyguibud/designer/dialogs/confirm.py:17
#: src/pyguibud/designer/dialogs/export.py:43
#: src/pyguibud/designer/dialogs/new_file.py:20
#: src/pyguibud/designer/dialogs/rename.py:20
#: src/pyguibud/designer/dialogs/save_changes.py:18
#: src/pyguibud/designer/dialogs/text.py:26
msgid "_Cancel"
msgstr "_Abbrechen"

#. Translators: the OK button of a message; _ marks the access key
#. (Alt+letter).
#. Translators: the buttons of the rename dialog; _ marks the access key
#. Translators: the buttons of the text dialog; _ marks the access key
#: src/pyguibud/designer/app.py:98 src/pyguibud/designer/dialogs/message.py:21
#: src/pyguibud/designer/dialogs/rename.py:19
#: src/pyguibud/designer/dialogs/text.py:25
msgid "_OK"
msgstr "_OK"

#. Translators: the confirmation button of "The document has {count} errors.
#. Save anyway?".
#. Translators: the buttons of the unsaved-changes question; _ marks the access
#. key.
#: src/pyguibud/designer/app.py:100
#: src/pyguibud/designer/dialogs/save_changes.py:16
#: src/pyguibud/designer/standard_actions.py:96
msgid "_Save"
msgstr "_Speichern"

#: src/pyguibud/designer/app.py:103
msgid "_Clear list"
msgstr "_Liste leeren"

#: src/pyguibud/designer/app.py:104
msgid "Your settings could not be saved."
msgstr "Ihre Einstellungen konnten nicht gespeichert werden."

#. Translators: {reason} is an error description from the operating system;
#. shown when quitting.
#: src/pyguibud/designer/app.py:107
#, python-brace-format
msgid ""
"Your settings could not be saved: {reason} Quit anyway? Your work is not "
"affected."
msgstr ""
"Ihre Einstellungen konnten nicht gespeichert werden: {reason} Trotzdem "
"beenden? Ihre Arbeit ist nicht betroffen."

#. Translators: the {reason} above when the operating system gave none.
#: src/pyguibud/designer/app.py:110
msgid "The settings file cannot be read or written."
msgstr "Die Einstellungsdatei kann nicht gelesen oder geschrieben werden."

#. Translators: the button of "Quit anyway?"; its access key must differ from
#. "_Cancel".
#: src/pyguibud/designer/app.py:112
msgctxt "dialog"
msgid "_Quit"
msgstr "_Beenden"

#: src/pyguibud/designer/app.py:113
msgid "There is no unsaved work to recover."
msgstr "Es gibt keine ungespeicherte Arbeit, die wiederhergestellt werden könnte."

#: src/pyguibud/designer/app.py:114
#: src/pyguibud/designer/dialogs/recovery.py:24
msgid "_Discard"
msgstr "_Verwerfen"

#. Translators: status bar, after a paste into a text field was refused;
#. {limit} is a number.
#: src/pyguibud/designer/app.py:116
#, python-brace-format
msgid "The paste was not made: this field takes at most {limit} characters."
msgstr ""
"Das Einfügen wurde nicht ausgeführt: Dieses Feld nimmt höchstens {limit} "
"Zeichen auf."

#. Translators: status bar after opening a file; {count} is the number of
#. warnings.
#: src/pyguibud/designer/app.py:518
#, python-brace-format
msgid "Opened with {count} warning."
msgid_plural "Opened with {count} warnings."
msgstr[0] "Mit {count} Warnung geöffnet."
msgstr[1] "Mit {count} Warnungen geöffnet."

#. Translators: asked before saving; {count} is the number of errors in the
#. document.
#: src/pyguibud/designer/app.py:623
#, python-brace-format
msgid "The document has {count} error. Save anyway?"
msgid_plural "The document has {count} errors. Save anyway?"
msgstr[0] "Das Dokument enthält {count} Fehler. Trotzdem speichern?"
msgstr[1] "Das Dokument enthält {count} Fehler. Trotzdem speichern?"

#. Translators: {widget} is a palette item ("Button"), {container} the id of a
#. window or frame.
#: src/pyguibud/designer/canvas/drag.py:55
#, python-brace-format
msgid "Release to insert '{widget}' into '{container}'."
msgstr "Loslassen zum Einfügen von '{widget}' in '{container}'."

#. Translators: {id} is the element being resized; {columns} and {rows} are
#. cell counts.
#: src/pyguibud/designer/canvas/drag.py:59
#, python-brace-format
msgid "Release to resize '{id}' to {columns} × {rows} cells."
msgstr "Loslassen, um '{id}' auf {columns} × {rows} Zellen zu ändern."

#: src/pyguibud/designer/canvas/drag.py:60
#: src/pyguibud/designer/panels/tree.py:36
msgid "Release to cancel."
msgstr "Loslassen zum Abbrechen."

#: src/pyguibud/designer/canvas/drag.py:61
#: src/pyguibud/designer/panels/tree.py:37
msgid "Drag cancelled."
msgstr "Ziehen abgebrochen."

#. Translators: {id} is the id of the element that was just added.
#: src/pyguibud/designer/canvas/drag.py:63
#, python-brace-format
msgid "Inserted '{id}'."
msgstr "'{id}' eingefügt."

#. Translators: {widget} is a palette item ("Button").
#: src/pyguibud/designer/canvas/drag.py:66
#, python-brace-format
msgid ""
"Drag '{widget}' onto the canvas, or press Enter to insert it into the "
"selected container."
msgstr ""
"Ziehen Sie '{widget}' auf die Zeichenfläche, oder drücken Sie die "
"Eingabetaste, um es in den ausgewählten Container einzufügen."

#: src/pyguibud/designer/canvas/drag.py:68
msgid "Menus and actions are edited in the menu editor."
msgstr "Menüs und Aktionen werden im Menü-Editor bearbeitet."

#. Translators: drawn on the canvas in place of an included component;
#. {component} is its id.
#: src/pyguibud/designer/canvas/engine.py:35
#, python-brace-format
msgid "Included: {component}"
msgstr "Enthalten: {component}"

#. Translators: drawn on the canvas in place of a plugin widget whose factory
#. failed; {name} is
#. its class name such as "acme:Gauge".
#: src/pyguibud/designer/canvas/engine.py:38
#, python-brace-format
msgid "{name} — the plugin failed"
msgstr "{name}: Das Plugin ist fehlgeschlagen"

#: src/pyguibud/designer/clipboard.py:78
msgid "Menus and actions cannot be copied yet."
msgstr "Menüs und Aktionen können noch nicht kopiert werden."

#: src/pyguibud/designer/clipboard.py:79
msgid "The clipboard content is too large to paste."
msgstr "Der Inhalt der Zwischenablage ist zu groß zum Einfügen."

#: src/pyguibud/designer/clipboard.py:80
msgid "The clipboard holds no PyGUIbud elements."
msgstr "Die Zwischenablage enthält keine PyGUIbud-Elemente."

#. Translators: {reason} is the first validation error of the clipboard
#. content.
#: src/pyguibud/designer/clipboard.py:82
#, python-brace-format
msgid "The clipboard content is not valid: {reason}"
msgstr "Der Inhalt der Zwischenablage ist ungültig: {reason}"

#. Translators: {id} is a pasted include whose component exists only in the
#. file it came from.
#: src/pyguibud/designer/clipboard.py:85
#, python-brace-format
msgid ""
"'{id}' includes a component of its original file; paste that component "
"first."
msgstr ""
"'{id}' enthält eine Komponente seiner ursprünglichen Datei; fügen Sie "
"zuerst diese Komponente ein."

#. Translators: {limit} is the largest number of widgets one paste may add.
#: src/pyguibud/designer/clipboard.py:88
#, python-brace-format
msgid "Paste refused: more than {limit} widgets."
msgstr "Einfügen abgelehnt: mehr als {limit} Widgets."

#. Translators: {limit} is the largest number of widgets one duplicate may add.
#: src/pyguibud/designer/clipboard.py:90
#, python-brace-format
msgid "Duplicate refused: more than {limit} widgets."
msgstr "Duplizieren abgelehnt: mehr als {limit} Widgets."

#. Translators: {version} and {current} are schema versions such as 1.1 and
#. 1.0.
#: src/pyguibud/designer/clipboard.py:93
#, python-brace-format
msgid ""
"The clipboard content uses schema version {version}, newer than "
"{current}; it cannot be pasted."
msgstr ""
"Der Inhalt der Zwischenablage verwendet Schemaversion {version}, neuer "
"als {current}; er kann nicht eingefügt werden."

#: src/pyguibud/designer/clipboard.py:101
msgid "Paste"
msgstr "Einfügen"

#: src/pyguibud/designer/clipboard.py:102
msgid "Cut"
msgstr "Ausschneiden"

#: src/pyguibud/designer/clipboard.py:103
msgid "Duplicate"
msgstr "Duplizieren"

#. Translators: {count} is the number of pasted top-level elements.
#: src/pyguibud/designer/clipboard.py:133
#, python-brace-format
msgid "Pasted {count} element."
msgid_plural "Pasted {count} elements."
msgstr[0] "{count} Element eingefügt."
msgstr[1] "{count} Elemente eingefügt."

#. Translators: after "Pasted N elements."; {count} is the number of warnings
#. about the
#. pasted content (unknown content is kept, as when a file is opened).
#: src/pyguibud/designer/clipboard.py:141
#, python-brace-format
msgid "The clipboard content had {count} warning."

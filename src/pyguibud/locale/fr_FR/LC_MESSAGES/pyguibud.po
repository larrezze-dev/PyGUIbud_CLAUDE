#: src/pyguibud/designer/sizing.py:114
#, python-brace-format
msgid "Release to set the minimum size of '{id}' to {width} × {height} px."
msgstr ""
"Relâchez pour définir la taille minimale de '{id}' à {width} × {height} "
"px."

#: src/pyguibud/designer/sizing.py:118
#, python-brace-format
msgid "'{id}' is as small as its contents allow; the minimum width was cleared."
msgstr ""
"'{id}' est aussi petit que son contenu le permet ; la largeur minimale a "
"été effacée."

#: src/pyguibud/designer/sizing.py:119
#, python-brace-format
msgid "'{id}' is as small as its contents allow; the minimum height was cleared."
msgstr ""
"'{id}' est aussi petit que son contenu le permet ; la hauteur minimale a "
"été effacée."

#: src/pyguibud/designer/sizing.py:120
#, python-brace-format
msgid "'{id}' is as small as its contents allow; the minimum size was cleared."
msgstr ""
"'{id}' est aussi petit que son contenu le permet ; la taille minimale a "
"été effacée."

#: src/pyguibud/designer/sizing.py:122
#, python-brace-format
msgid "'{id}' keeps its natural size."
msgstr "'{id}' conserve sa taille naturelle."

#: src/pyguibud/designer/sizing.py:123
#, python-brace-format
msgid "Resized '{id}'."
msgstr "'{id}' redimensionné."

#: src/pyguibud/designer/sizing.py:125
msgid ""
"A component takes its size from the window that includes it; this size is"

#, python-brace-format
msgid "Release to set the size of '{id}' to {width} × {height}."
msgstr "Relâchez pour définir la taille de '{id}' à {width} × {height}."

#. Translators: off the canvas tab; {value} is a size such as "14 characters"
#. (or width and
#. height), what a release back on the canvas would set (QA-14b1-01).
#: src/pyguibud/designer/sizing.py:109
#, python-brace-format
msgid "Release here to cancel. On the canvas, '{id}' would be set to {value}."
msgstr ""
"Relâchez ici pour annuler. Sur la zone de dessin, '{id}' serait défini à "
"{value}."

#. Translators: {id} is an element whose canvas drawing failed, so nothing
#. could be measured.
#: src/pyguibud/designer/sizing.py:111
#, python-brace-format
msgid "'{id}' could not be measured on the canvas; set its size in the inspector."
msgstr ""
"'{id}' n'a pas pu être mesuré sur la zone de dessin ; définissez sa "
"taille dans l'inspecteur."


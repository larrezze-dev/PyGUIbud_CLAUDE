msgid "Amount format"
msgstr "Format du montant"

#: src/pyguibud/core/widgets.py:419
msgid "Show text"
msgstr "Afficher le texte"

#: src/pyguibud/core/widgets.py:420
msgid "Interactive"
msgstr "Interactif"

#: src/pyguibud/core/widgets.py:425
msgid "Flood gauge"
msgstr "Floodgauge"

#: src/pyguibud/core/widgets.py:435
msgid "Text mask"
msgstr "Masque de texte"

#: src/pyguibud/core/widgets.py:444
msgid "Date entry"
msgstr "Saisie de date"

#: src/pyguibud/core/widgets.py:456
msgid "Date"
msgstr "Date"

#: src/pyguibud/core/widgets.py:460
msgid "a date written as YYYY-MM-DD, from 1900-01-01 to 9998-12-31"
msgstr "une date écrite sous la forme AAAA-MM-JJ, du 1900-01-01 au 9998-12-31"

#: src/pyguibud/core/widgets.py:465
msgid "Date format"
msgstr "Format de date"

#. Translators: keep the %-codes exactly as written.
#: src/pyguibud/core/widgets.py:470
#, python-format
msgid "one each of day %d, month %m %b or %B, year %Y or %y; also %a %A %j %%"
msgstr ""
"un de chaque : jour %d, mois %m %b ou %B, année %Y ou %y ; également %a "
"%A %j %%"

#: src/pyguibud/core/widgets.py:472
msgid "First day of the week"
msgstr "Premier jour de la semaine"

#: src/pyguibud/core/widgets.py:477
msgid "Table view"
msgstr "Vue tableau"

#: src/pyguibud/core/widgets.py:486

msgstr "Relâchez pour définir la largeur de '{id}' à {value}."

#: src/pyguibud/designer/sizing.py:103
#, python-brace-format
msgid "Release to set the height of '{id}' to {value}."
msgstr "Relâchez pour définir la hauteur de '{id}' à {value}."


#: src/pyguibud/core/xml_io.py:488
#, python-brace-format
msgid ""
"Unknown attribute '{attribute}' on <{element}> is kept as it is; check "
"its spelling."
msgstr ""
"O atributo desconhecido '{attribute}' em <{element}> é mantido como está;"
" verifique a grafia."


"The attribute '{attribute}' of <{element}> must be one of {choices}, not "
"'{value}'."
msgstr ""
"O atributo '{attribute}' de <{element}> deve ser um destes valores: "
"{choices}; não '{value}'."

#. Translators: {id} is an identifier from the file.
#: src/pyguibud/core/xml_io.py:655
#, python-brace-format
msgid "The resource id '{id}' is declared more than once."
msgstr "O id de recurso '{id}' é declarado mais de uma vez."

#. Translators: {id} is an identifier from the file.
#: src/pyguibud/core/xml_io.py:684
#, python-brace-format
msgid "The variable id '{id}' is declared more than once."
msgstr "O id de variável '{id}' é declarado mais de uma vez."

#. Translators: {name} is a property name.

#, python-brace-format
msgid "The property '{name}' must contain plain text only, not elements."
msgstr "A propriedade '{name}' deve conter somente texto simples, não elementos."

#. Translators: {name} is a property name, {element} an XML element name.
#: src/pyguibud/core/xml_io.py:734
#, python-brace-format

#: src/pyguibud/core/xml_io.py:159
msgid "This is a folder, not a .ui file."
msgstr "Esta é uma pasta, não um arquivo .ui."

#: src/pyguibud/core/xml_io.py:164
msgid "This is a device or another special file, not a .ui file."
msgstr "Este é um dispositivo ou outro arquivo especial, não um arquivo .ui."

#: src/pyguibud/core/xml_io.py:172
msgid "The file does not exist."
msgstr "O arquivo não existe."

#. Translators: {reason} is an error description from the operating system.
#: src/pyguibud/core/xml_io.py:178
#, python-brace-format
msgid "The file could not be read: {reason}"
msgstr "Não foi possível ler o arquivo: {reason}"

#: src/pyguibud/core/xml_io.py:203
msgid "The file is not valid UTF-8 text; save it with UTF-8 encoding."
msgstr "O arquivo não é um texto UTF-8 válido; salve-o com codificação UTF-8."

#. Translators: {namespace} is the XML namespace URI of PyGUIbud files.
#: src/pyguibud/core/xml_io.py:217
#, python-brace-format
msgid ""
"This is not a PyGUIbud .ui file: the root element must be <pyguibud-ui> "
"in the namespace {namespace}."
msgstr ""
"Este não é um arquivo .ui do PyGUIbud: o elemento raiz deve ser "
"<pyguibud-ui> no namespace {namespace}."

#. Translators: {limit} is a whole number of mebibytes.
#: src/pyguibud/core/xml_io.py:229 src/pyguibud/core/xml_io.py:1113
#, python-brace-format
msgid "The file is larger than the limit of {limit} MiB for .ui files."
msgstr "O arquivo é maior que o limite de {limit} MiB para arquivos .ui."

#. Translators: {element} is an XML element name, {attribute} an attribute
#. name.
#: src/pyguibud/core/xml_io.py:265 src/pyguibud/core/xml_io.py:503
#, python-brace-format
msgid "The element <{element}> needs the attribute '{attribute}'."
msgstr "O elemento <{element}> precisa do atributo '{attribute}'."

#. Translators: {version} is the text found in the file; keep MAJOR.MINOR as it
#. is.
#: src/pyguibud/core/xml_io.py:277
#, python-brace-format
msgid ""
"'{version}' is not a valid schema version; expected MAJOR.MINOR, for "
"example 1.0."
msgstr ""
"'{version}' não é uma versão de esquema válida; o esperado é MAJOR.MINOR,"
" por exemplo 1.0."

#. Translators: {version} and {current} are schema versions such as 2.0 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:289
#, python-brace-format
msgid ""
"This file uses schema version {version}; it needs a newer PyGUIbud (this "
"one supports {current})."
msgstr ""
"Este arquivo usa a versão {version} do esquema; é necessário um PyGUIbud "
"mais recente (este suporta {current})."

#. Translators: {version} and {current} are schema versions such as 1.1 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:307
#, python-brace-format
msgid ""
"This file uses schema version {version}, newer than {current}; it is "
"opened read-only so that nothing is lost."
msgstr ""
"Este arquivo usa a versão {version} do esquema, mais recente que "
"{current}; ele é aberto somente para leitura para que nada se perca."

#. Translators: {version} and {current} are schema versions such as 0.9 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:323
#, python-brace-format
msgid ""
"The file was upgraded from schema version {version} to {current}; saving "
"writes the new version."
msgstr ""
"O arquivo foi atualizado da versão {version} do esquema para {current}; "
"ao salvar, a nova versão será gravada."

#. Translators: {count} is a number of XML comments and processing
#. instructions.
#: src/pyguibud/core/xml_io.py:343
#, python-brace-format
msgid ""
"Comments and processing instructions ({count}) are not kept when the file"
" is saved."
msgstr ""
"Comentários e instruções de processamento ({count}) não são mantidos ao "
"salvar o arquivo."

#. Translators: {element} is an XML element name.
#: src/pyguibud/core/xml_io.py:405
#, python-brace-format
msgid "Text is not allowed directly inside <{element}>."
msgstr "Texto não é permitido diretamente dentro de <{element}>."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:426
#, python-brace-format
msgid ""
"Unknown element <{element}> inside <{parent}> is kept as it is; check its"
" spelling."
msgstr ""
"O elemento desconhecido <{element}> dentro de <{parent}> é mantido como "
"está; verifique a grafia."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:439
#, python-brace-format
msgid "<{element}> is not allowed inside <{parent}>."
msgstr "<{element}> não é permitido dentro de <{parent}>."

#. Translators: {element} and {parent} are XML element names.

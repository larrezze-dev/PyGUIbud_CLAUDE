#: src/pyguibud/core/xml_io.py:554
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be true or false, not "
"'{value}'."
msgstr ""
"O atributo '{attribute}' de <{element}> deve ser true ou false, não "
"'{value}'."


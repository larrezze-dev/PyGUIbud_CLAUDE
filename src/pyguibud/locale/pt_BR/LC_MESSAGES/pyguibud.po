#, python-brace-format
msgid "<{element}> has more than one placement (<cell>, <pack> or <page>)."
msgstr "<{element}> tem mais de um posicionamento (<cell>, <pack> ou <page>)."

#. Translators: {name} is a property name; keep 'text' untranslated.
#: src/pyguibud/core/xml_io.py:985
#, python-brace-format
msgid "A <page> can only hold the property 'text', not '{name}'."
msgstr "Uma <page> só pode conter a propriedade 'text', não '{name}'."


msgstr "Una finestra con un contenitore a schede per le pagine delle impostazioni."

#: src/pyguibud/designer/templates/__init__.py:55
msgid "Empty component"
msgstr "Componente vuoto"

#: src/pyguibud/designer/templates/__init__.py:56
msgid "A reusable component with an empty grid layout."
msgstr "Un componente riutilizzabile con un layout a griglia vuoto."

#: src/pyguibud/designer/tree_dnd.py:22
msgid "Elements cannot be dragged to another window. Use Cut and Paste."
msgstr ""
"Gli elementi non possono essere trascinati in un'altra finestra. Usare "
"Taglia e Incolla."

#. Translators: {id} is the row under the pointer: a widget without children or
#. an include.
#: src/pyguibud/designer/tree_dnd.py:24
#, python-brace-format
msgid "'{id}' cannot hold elements: drop them before or after it."
msgstr "'{id}' non può contenere elementi: rilasciarli prima o dopo di esso."

#: src/pyguibud/designer/tree_dnd.py:25
msgid "Drop elements onto a window, onto a container or next to an element."
msgstr ""
"Rilasciare gli elementi su una finestra, su un contenitore o accanto a un"
" elemento."

#. Translators: {id} is the element being moved, {container} the id of a window
#. or frame.
#: src/pyguibud/designer/canvas/drag.py:57 src/pyguibud/designer/tree_dnd.py:31
#, python-brace-format
msgid "Release to move '{id}' into '{container}'."
msgstr "Rilascia per spostare '{id}' in '{container}'."

#. Translators: shown while dragging; {count} is the number of elements being
#. moved.
#: src/pyguibud/designer/canvas/drag.py:637
#: src/pyguibud/designer/tree_dnd.py:156
#, python-brace-format
msgid "Release to move {count} element."
msgid_plural "Release to move {count} elements."
msgstr[0] "Rilascia per spostare {count} elemento."
msgstr[1] "Rilascia per spostare {count} elementi."

#: src/pyguibud/designer/windows.py:28
#, python-brace-format
msgid "Delete the window '{id}' and everything in it?"
msgstr "Eliminare la finestra '{id}' e tutto il suo contenuto?"

#: src/pyguibud/i18n.py:233
#, python-brace-format
msgid "Unknown language '{code}'. Valid codes: {valid}."
msgstr "Lingua '{code}' sconosciuta. Codici validi: {valid}."

#. Translators: {domain} is a catalogue name, {lang} a language code and
#. {directory} a folder.
#: src/pyguibud/i18n.py:373
#, python-brace-format
msgid ""
"No usable translations '{domain}' for '{lang}' in '{directory}'; the "
"source texts are shown."
msgstr ""
"Nessuna traduzione utilizzabile '{domain}' per '{lang}' in '{directory}';"
" vengono mostrati i testi di origine."

#: src/pyguibud/preview/__init__.py:42
msgid "Show a .ui file in a separate preview window (used by the designer)."
msgstr ""
"Mostra un file .ui in una finestra di anteprima separata (usato dal "
"designer)."

#: src/pyguibud/preview/_host.py:20 src/pyguibud_runtime/_load.py:60
#, python-brace-format
msgid "No display is available, so no window can be opened: {reason}"
msgstr ""
"Nessun display disponibile, quindi non è possibile aprire alcuna "
"finestra: {reason}"

#: src/pyguibud/preview/_host.py:21 src/pyguibud_runtime/_load.py:55
#, python-brace-format
msgid "The backend '{name}' is not available: {reason}"
msgstr "Il backend '{name}' non è disponibile: {reason}"

#. Translators: the {reason} of "The backend '{name}' is not available:
#. {reason}" (lower case).
#: src/pyguibud/preview/_host.py:24
msgid "it has no preview host, so it cannot be previewed."
msgstr ""
"non dispone di un host di anteprima, quindi non può essere visualizzato "
"in anteprima."

#. Translators: {option} and {other} are command-line options such as "-o" and
#. "--check"; they
#. are never translated.
#: src/pyguibud/uic.py:48
#, python-brace-format
msgid "{option} cannot be used with {other}"
msgstr "{option} non può essere usato con {other}"

#. Translators: {option} is a command-line option ("-o"); it is never
#. translated.
#: src/pyguibud/uic.py:50
#, python-brace-format
msgid "{option} can be used with one input file only"
msgstr "{option} può essere usato con un solo file di input"

#: src/pyguibud/uic.py:58
msgid ""
"Check PyGUIbud .ui files, generate Python code from them and extract "
"their texts for translation."
msgstr ""
"Consente di controllare i file .ui di PyGUIbud, generare codice Python da"
" essi ed estrarne i testi per la traduzione."

#. Translators: {group} is the name of a Python entry-point group; it is never
#. translated.
#: src/pyguibud/uic.py:63
#, python-brace-format
msgid ""
"The check loads the installed widget plugins (entry point {group}), which"
" runs their code; only check files with plugins you trust."
msgstr ""
"Il controllo carica i plugin di widget installati (gruppo di punti di "
"ingresso {group}) ed esegue il loro codice; controllare solo file con "
"plugin di cui ci si fida."

#: src/pyguibud/uic.py:86
msgid "read and validate each file and report errors and warnings"
msgstr "legge e convalida ogni file e segnala errori e avvisi"

#: src/pyguibud/uic.py:91
msgid ""
"write a translation template (.pot) with the translatable texts of the "
"files"
msgstr "scrive un modello di traduzione (.pot) con i testi traducibili dei file"

#. Translators: {pattern} is a file name pattern and {extract} a command-line
#. option; both
#. are never translated.
#: src/pyguibud/uic.py:101
#, python-brace-format
msgid ""
"output file (generate: default {pattern} next to the .ui file; {extract}:"
" default standard output)"
msgstr ""
"file di output (generazione: predefinito {pattern} accanto al file .ui; "
"{extract}: predefinito l'output standard)"

#. Translators: {program} is the name of this command; it is never translated.
#: src/pyguibud/uic.py:110
#, python-brace-format
msgid ""
"replace an output file even if {program} did not generate it, and "
"generate code from images and includes outside the folder of the .ui file"
msgstr ""
"sostituisce un file di output anche se non è stato generato da {program} "
"e genera codice da immagini e inclusioni esterne alla cartella del file "
".ui"

#: src/pyguibud/uic.py:114
msgid ".ui file to process"
msgstr "file .ui da elaborare"

#. Translators: {path} is a file name as typed by the user.
#: src/pyguibud/uic.py:163
#, python-brace-format
msgid "{path}: no errors found"
msgstr "{path}: nessun errore rilevato"

#. Translators: {path} is the .ui file, {output} the Python file written from
#. it.
#: src/pyguibud/uic.py:209
#, python-brace-format
msgid "{path}: wrote {output}"
msgstr "{path}: scritto {output}"

#. Translators: {output} is the translation template (.pot) that was written.
#: src/pyguibud/uic.py:251
#, python-brace-format
msgid "wrote {output}"
msgstr "scritto {output}"

#: src/pyguibud/uic.py:290
msgid "no file matches this pattern"
msgstr "nessun file corrisponde a questo modello"

#: src/pyguibud_runtime/_load.py:41
#, python-brace-format
msgid "The .ui file '{path}' cannot be loaded: {reason}"
msgstr "Impossibile caricare il file .ui '{path}': {reason}"

#. Translators: {count} is the number of validation errors, {path} the .ui file
#. name.
#: src/pyguibud_runtime/_load.py:44
#, python-brace-format
msgid "{count} error prevents loading '{path}'."
msgid_plural "{count} errors prevent loading '{path}'."
msgstr[0] "{count} errore impedisce il caricamento di '{path}'."
msgstr[1] "{count} errori impediscono il caricamento di '{path}'."

#. Translators: {argument} is the name of a Python argument ("master="); keep
#. it unchanged.
#: src/pyguibud_runtime/_load.py:47
#, python-brace-format
msgid "'{path}' has no main window; pass {argument} to load its dialogs."
msgstr ""
"'{path}' non ha una finestra principale; passare {argument} per caricarne"
" le finestre di dialogo."

#: src/pyguibud_runtime/_load.py:48
#, python-brace-format
msgid "'{path}' contains only components; include them from another .ui file."
msgstr "'{path}' contiene solo componenti; includerli da un altro file .ui."

#. Translators: {target} is the handlers object (its type name), {names} a
#. comma-separated list.
#: src/pyguibud_runtime/_load.py:51
#, python-brace-format
msgid "{count} handler is missing or not callable on {target}: {names}."
msgid_plural "{count} handlers are missing or not callable on {target}: {names}."
msgstr[0] "{count} gestore di eventi manca o non è richiamabile su {target}: {names}."
msgstr[1] ""
"{count} gestori di eventi mancano o non sono richiamabili su {target}: "
"{names}."

#: src/pyguibud_runtime/_load.py:54
#, python-brace-format
msgid ""
"The handler '{name}' is missing or not callable on {target}; it is not "
"bound."
msgstr ""
"Il gestore di eventi '{name}' manca o non è richiamabile su {target}; non"
" è associato."

#. Translators: {argument} is the name of a Python argument ("master="); keep
#. it unchanged.
#: src/pyguibud_runtime/_load.py:58
#, python-brace-format
msgid ""
"A Tk root window already exists; pass it as {argument} to load another "
".ui file into it."
msgstr ""
"Esiste già una finestra radice Tk; passarla come {argument} per caricarvi"
" un altro file .ui."

#: src/pyguibud_runtime/_load.py:61
#, python-brace-format
msgid "Building the interface from '{path}' failed: {reason}"
msgstr "Creazione dell'interfaccia da '{path}' non riuscita: {reason}"

#. Translators: {reason} of the message above when a widget factory broke the
#. toolkit; the raw
#. toolkit text is not shown, but it stays available as the exception's
#. __cause__.
#: src/pyguibud_runtime/_load.py:64
msgid "the toolkit reported an error (see the exception's __cause__)"
msgstr "il toolkit ha segnalato un errore (vedere __cause__ dell'eccezione)"

#. Translators: {value} is the rejected argument as Python shows it; {example}
#. is a language
#. code that is never translated.
#: src/pyguibud_runtime/_texts.py:29
#, python-brace-format
msgid "lang must be a language code such as '{example}', not {value}"
msgstr "lang deve essere un codice lingua come '{example}', non {value}"

#: src/pyguibud_runtime/_ui.py:19
msgid "This interface has been destroyed."
msgstr "Questa interfaccia è stata distrutta."

#: src/pyguibud_runtime/_ui.py:20
#, python-brace-format
msgid "'{id}' is not a main or dialog window of this interface."
msgstr "'{id}' non è una finestra principale o di dialogo di questa interfaccia."

#. Translators: closes a list of problems that was cut after 20 lines.
#: src/pyguibud_runtime/errors.py:14
#, python-brace-format
msgid "… and {count} more problem."
msgid_plural "… and {count} more problems."
msgstr[0] "… e {count} problema in più."
msgstr[1] "… e {count} problemi in più."


<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1" xmlns:tb="urn:pyguibud:ext:ttkbootstrap:1">
  <meta generator="pyguibud" source_locale="en_GB"/>
  <window id="settings" kind="main" min_width="480" min_height="320">
    <prop name="title" translatable="true" context="window title">Settings</prop>
    <layout type="grid" padding="12" gap="6">
      <column index="0" weight="1"/>
      <row index="0" weight="1"/>
    </layout>
    <widget class="Notebook" id="nbk_settings">
      <cell row="0" column="0" sticky="nsew"/>
      <widget class="Frame" id="frm_general">
        <page>
          <prop name="text" translatable="true" context="tab">General</prop>
        </page>
        <layout type="pack" padding="12"/>
        <widget class="Checkbutton" id="chk_updates">
          <prop name="text" translatable="true">Check for updates</prop>
          <pack fill="x"/>
        </widget>
      </widget>
      <widget class="Frame" id="frm_advanced">
        <page>
          <prop name="text" translatable="true" context="tab">Advanced</prop>
        </page>
        <layout type="pack" padding="12"/>
        <widget class="Checkbutton" id="chk_logging">
          <prop name="text" translatable="true">Write a log file</prop>
          <pack fill="x"/>
        </widget>
      </widget>
    </widget>
  </window>
</pyguibud-ui>

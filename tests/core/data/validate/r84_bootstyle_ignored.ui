<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1" xmlns:tb="urn:pyguibud:ext:ttkbootstrap:1">
  <window id="main">
    <layout type="grid"/>
    <widget class="Button" id="a" tb:bootstyle="primary sparkly"><cell row="0" column="0"/></widget>
    <widget class="Listbox" id="b" tb:bootstyle="info"><cell row="1" column="0"/></widget>
    <widget class="Button" id="c" tb:bootstyle="success-outline"><cell row="2" column="0"/></widget>
  </window>
</pyguibud-ui>

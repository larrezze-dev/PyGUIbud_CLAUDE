<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1">
  <resources>
    <image id="logo" src="/usr/logo.png"/>
  </resources>
  <window id="main">
    <layout type="grid"/>
    <include id="a" src="/abs/x.ui" component="Panel"><cell row="0" column="0"/></include>
    <include id="b" src="C:\x.ui" component="Panel"><cell row="1" column="0"/></include>
    <include id="c" src="\\server\share\x.ui" component="Panel"><cell row="2" column="0"/></include>
  </window>
</pyguibud-ui>

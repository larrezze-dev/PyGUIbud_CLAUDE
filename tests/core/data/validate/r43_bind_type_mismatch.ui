<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1">
  <variables>
    <var id="s" type="string"/>
    <var id="flag" type="bool"/>
    <var id="d" type="double"/>
  </variables>
  <window id="main">
    <layout type="grid"/>
    <widget class="Checkbutton" id="a" bind="s"><cell row="0" column="0"/></widget>
    <widget class="Combobox" id="b" bind="d"><cell row="1" column="0"/></widget>
    <widget class="Entry" id="c" bind="flag"><cell row="2" column="0"/></widget>
    <widget class="Entry" id="ok" bind="s"><cell row="3" column="0"/></widget>
  </window>
</pyguibud-ui>

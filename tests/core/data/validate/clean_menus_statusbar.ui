<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1">
  <window id="main">
    <menubar>
      <menu id="mnu_file">
        <prop name="text">File</prop>
        <action id="act_quit" handler="on_quit"><prop name="text">Quit</prop></action>
        <separator/>
      </menu>
    </menubar>
    <statusbar id="sts"><prop name="text">Ready</prop></statusbar>
    <layout type="grid"/>
  </window>
</pyguibud-ui>

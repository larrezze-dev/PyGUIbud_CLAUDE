<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1">
  <window id="main">
    <layout type="grid"/>
    <widget class="Label" id="a"><prop name="width">wide</prop><cell row="0" column="0"/></widget>
    <widget class="Scale" id="b"><prop name="minimum">1,5</prop><cell row="1" column="0"/></widget>
    <widget class="ScrolledFrame" id="c"><prop name="autohide">yes</prop><layout type="grid"/><cell row="2" column="0"/></widget>
    <widget class="Button" id="d"><prop name="state">maybe</prop><cell row="3" column="0"/></widget>
    <widget class="Canvas" id="e"><prop name="background">#12</prop><cell row="4" column="0"/></widget>
    <widget class="Label" id="f"><prop name="width"></prop><cell row="5" column="0"/></widget>
  </window>
</pyguibud-ui>

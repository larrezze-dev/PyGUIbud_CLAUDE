<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1">
  <window id="main">
    <layout type="grid"/>
    <widget class="Label" id="a"><event name="command" handler="on_a"/><event name="key:&lt;Control-s&gt;" handler="on_b"/><cell row="0" column="0"/></widget>
    <widget class="Button" id="b"><event name="key:&lt;Return&gt;" handler="on_c"/><cell row="1" column="0"/></widget>
  </window>
</pyguibud-ui>

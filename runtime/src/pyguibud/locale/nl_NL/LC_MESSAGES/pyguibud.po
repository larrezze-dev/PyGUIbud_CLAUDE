#: src/pyguibud/_argparse.py:48 src/pyguibud/_argparse.py:127
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s:"

#: src/pyguibud/_argparse.py:49
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s: fout: %(message)s\n"

#: src/pyguibud/_argparse.py:50
#, python-format
msgid " (default: %(default)s)"
msgstr " (standaard: %(default)s)"

#: src/pyguibud/_argparse.py:51
#, python-format
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "dubbelzinnige optie: %(option)s kan overeenkomen met %(matches)s"

#: src/pyguibud/_argparse.py:52 src/pyguibud/_argparse.py:168
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "argument %(argument_name)s: %(message)s"

#: src/pyguibud/_argparse.py:53
msgid "expected at least one argument"
msgstr "minstens één argument verwacht"

#: src/pyguibud/_argparse.py:54
msgid "expected at most one argument"
msgstr "hoogstens één argument verwacht"

#: src/pyguibud/_argparse.py:55
msgid "expected one argument"
msgstr "één argument verwacht"

#: src/pyguibud/_argparse.py:56
#, python-format
msgid "expected %s argument"
msgid_plural "expected %s arguments"
msgstr[0] "%s argument verwacht"
msgstr[1] "%s argumenten verwacht"

#: src/pyguibud/_argparse.py:57
#, python-format
msgid "ignored explicit argument %r"
msgstr "expliciet argument %r genegeerd"

#: src/pyguibud/_argparse.py:58
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "ongeldige waarde voor %(type)s: %(value)r"

#: src/pyguibud/_argparse.py:59
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "ongeldige keuze: %(value)r (kies uit %(choices)s)"

#: src/pyguibud/_argparse.py:60
#, python-format
msgid "not allowed with argument %s"
msgstr "niet toegestaan met argument %s"

#: src/pyguibud/_argparse.py:61
#, python-format
msgid "one of the arguments %s is required"
msgstr "een van de argumenten %s is vereist"

#: src/pyguibud/_argparse.py:62
msgid "optional arguments"
msgstr "optionele argumenten"

#: src/pyguibud/_argparse.py:63
msgid "options"
msgstr "opties"

#: src/pyguibud/_argparse.py:64
msgid "positional arguments"
msgstr "positionele argumenten"

#: src/pyguibud/_argparse.py:65
msgid "show program's version number and exit"
msgstr "het versienummer van het programma tonen en afsluiten"

#: src/pyguibud/_argparse.py:66 src/pyguibud/_argparse.py:155
msgid "show this help message and exit"
msgstr "dit helpbericht tonen en afsluiten"

#: src/pyguibud/_argparse.py:67
#, python-format
msgid "the following arguments are required: %s"
msgstr "de volgende argumenten zijn vereist: %s"

#: src/pyguibud/_argparse.py:68
#, python-format
msgid "unexpected option string: %s"
msgstr "onverwachte optietekenreeks: %s"

#: src/pyguibud/_argparse.py:69
#, python-format
msgid "unrecognized arguments: %s"
msgstr "niet-herkende argumenten: %s"

#: src/pyguibud/_argparse.py:70
msgid "usage: "
msgstr "gebruik: "

#. Translators: a program shows both Tk (tkinter) and Qt windows.
#: src/pyguibud/backends/_qt.py:74
msgid ""
"Tk and Qt windows in one process: only one toolkit's windows respond at a"
" time."
msgstr ""
"Tk- en Qt-vensters in één proces: slechts de vensters van één toolkit "
"reageren tegelijk."

#. Translators: an image file of the .ui could not be decoded by Qt; it is not
#. shown.
#: src/pyguibud/backends/_qt.py:76
#, python-brace-format
msgid "The image '{image}' cannot be displayed by Qt; it is left out."
msgstr ""
"De afbeelding '{image}' kan niet door Qt worden weergegeven; deze wordt "
"weggelaten."

#. Translators: {name} is a colour name from a .ui file, such as SeaGreen3.
#: src/pyguibud/backends/_qt.py:78
#, python-brace-format
msgid ""
"The colour '{name}' of '{id}' is not known to Qt; the default colour is "
"used."
msgstr ""
"De kleur '{name}' van '{id}' is onbekend voor Qt; de standaardkleur wordt"
" gebruikt."

#: src/pyguibud/backends/_qt.py:79
#, python-brace-format
msgid "The minimum of '{id}' is greater than its maximum; Qt uses them swapped."
msgstr ""
"Het minimum van '{id}' is groter dan het maximum; Qt verwisselt beide "
"waarden."

#. Translators: padx and pady are .ui attribute names; keep them unchanged.
#: src/pyguibud/backends/_qt.py:81
#, python-brace-format
msgid "The padding (padx, pady) of '{id}' is ignored by Qt."
msgstr "De opvulling (padx, pady) van '{id}' wordt door Qt genegeerd."

#: src/pyguibud/backends/_qt.py:82
#, python-brace-format
msgid "The label '{id}' has an image and a text; Qt shows the image only."
msgstr ""
"Het label '{id}' heeft zowel een afbeelding als een tekst; Qt toont "
"alleen de afbeelding."

#. Translators: a spin box is bound to a text variable whose value is not a
#. number.
#: src/pyguibud/backends/_qt.py:84
#, python-brace-format
msgid "The spin box '{id}' cannot show a value that is not a number."
msgstr "Het draaivak '{id}' kan geen waarde tonen die geen getal is."

#: src/pyguibud/backends/_tbwidgets.py:95
msgid "Select a date"
msgstr "Selecteer een datum"

#. Translators: a keyboard shortcut appears twice in one window.
#: src/pyguibud/backends/_tk.py:60
#, python-brace-format
msgid "The shortcut '{shortcut}' of '{id}' is already used in this window."
msgstr "De sneltoets '{shortcut}' van '{id}' wordt al gebruikt in dit venster."

#. Translators: {count} is a number of widgets whose style was not applied;
#. {package} is the
#. package name ttkbootstrap and {attribute} the name of the .ui attribute
#. (both inserted as they
#. are); {toolkit} is the name of the toolkit.
#: src/pyguibud/backends/_tk.py:65
#, python-brace-format
msgid "{count} {package} style ({attribute}) is ignored by the {toolkit} toolkit."
msgid_plural ""
"{count} {package} styles ({attribute}) are ignored by the {toolkit} "
"toolkit."
msgstr[0] ""
"{count} {package}-stijl ({attribute}) wordt genegeerd door de toolkit "
"{toolkit}."
msgstr[1] ""
"{count} {package}-stijlen ({attribute}) worden genegeerd door de toolkit "
"{toolkit}."

#. Translators: a text (usually a translation) is too long to display; {length}
#. and {limit} are
#. numbers of characters.
#: src/pyguibud/backends/_tk.py:70
#, python-brace-format
msgid ""
"The text of '{id}' has {length} characters; only the first {limit} are "
"shown."
msgstr ""
"De tekst van '{id}' bevat {length} tekens; alleen de eerste {limit} "
"worden getoond."

#. Translators: a plugin's widget could not be created (runtime.plugin_failed).
#: src/pyguibud/backends/_tk.py:73
#, python-brace-format
msgid ""
"The widget class '{name}' failed to build; its fallback '{fallback}' is "
"shown."
msgstr ""
"De widgetklasse '{name}' kon niet worden gemaakt; de terugvalklasse "
"'{fallback}' wordt getoond."

#. Translators: a plugin's widget raised an error when its text was set again
#. (for example
#. after a language change); {name} is its widget class.
#: src/pyguibud/backends/_tk.py:77
#, python-brace-format
msgid "The widget class '{name}' could not show the new text of '{id}'."
msgstr "De widgetklasse '{name}' kon de nieuwe tekst van '{id}' niet weergeven."

#. Translators: a widget does not accept the handler of an event
#. (runtime.event_unsupported).
#: src/pyguibud/backends/_tk.py:79
#, python-brace-format
msgid "The event '{event}' of '{id}' is not supported by '{name}'."
msgstr "De gebeurtenis '{event}' van '{id}' wordt niet ondersteund door '{name}'."

#. Translators: logged when a .ui uses an extension widget the runtime cannot
#. render yet.
#: src/pyguibud/backends/_tkmap.py:71
#, python-brace-format
msgid "The widget class '{name}' is shown as its fallback '{fallback}'."
msgstr "De widgetklasse '{name}' wordt getoond als terugvaloptie '{fallback}'."

#. Translators: a ttkbootstrap style name from a .ui file was not applied.
#: src/pyguibud/backends/_tkmap.py:73
#, python-brace-format
msgid "The bootstyle '{value}' of '{id}' is ignored."
msgstr "De bootstyle '{value}' van '{id}' wordt genegeerd."

#. Translators: {value} is the text of a date property that is not a real
#. calendar date.
#: src/pyguibud/backends/_tkmap.py:75
#, python-brace-format
msgid "The date '{value}' is not a valid calendar date; it is ignored."
msgstr "De datum '{value}' is geen geldige kalenderdatum; deze wordt genegeerd."

#. Translators: {given} and {expected} are numbers; {text} is the ';'-separated
#. headings text.
#: src/pyguibud/backends/_tkmap.py:77
#, python-brace-format
msgid "{given} column headings for {expected} columns: '{text}'"
msgstr "{given} kolomkoppen voor {expected} kolommen: '{text}'"

#. Translators: {extra} is the literal install command; keep it unchanged.
#: src/pyguibud/backends/pyside6.py:27
#, python-brace-format
msgid "PySide6 is not installed. Install it with: {extra}"
msgstr "PySide6 is niet geïnstalleerd. Installeer het met: {extra}"

#: src/pyguibud/backends/pyside6.py:28
msgid "PySide6 interfaces must be loaded in the main thread."
msgstr "PySide6-interfaces moeten in de hoofdthread worden geladen."

#. Translators: the application already runs a Qt core application, which
#. cannot show windows.
#: src/pyguibud/backends/pyside6.py:30
msgid "The running Qt application has no graphical interface (QCoreApplication)."
msgstr ""
"De actieve Qt-toepassing heeft geen grafische interface "
"(QCoreApplication)."

#. Translators: {variables} is a comma-separated list of environment variable
#. names; keep it
#. unchanged.
#: src/pyguibud/backends/pyside6.py:33
#, python-brace-format
msgid "No display is set ({variables}), so Qt cannot open windows."
msgstr ""
"Er is geen beeldscherm ingesteld ({variables}), dus Qt kan geen vensters "
"openen."

#. Translators: {name} is the value of an environment variable and {variable}
#. its name; keep
#. {variable} unchanged.
#: src/pyguibud/backends/pyside6.py:36
#, python-brace-format
msgid "The Qt platform plugin '{name}' ({variable}) is not installed."
msgstr "De Qt-platformplug-in '{name}' ({variable}) is niet geïnstalleerd."

#. Translators: the .ui file asks for a ttkbootstrap theme that is not
#. installed.
#: src/pyguibud/backends/ttkbootstrap.py:19
#, python-brace-format
msgid "The theme '{theme}' is not available; the default theme is used."
msgstr ""
"Het thema '{theme}' is niet beschikbaar; het standaardthema wordt "
"gebruikt."

#. Translators: the application already has a window, so the .ui file's theme
#. is not applied.
#: src/pyguibud/backends/ttkbootstrap.py:21
#, python-brace-format
msgid "The theme '{theme}' is ignored because the application owns the theme."
msgstr "Het thema '{theme}' wordt genegeerd omdat de toepassing het thema beheert."

#. Translators: {code} is what the user typed, {valid} a list of language
#. codes.
#: src/pyguibud/cli.py:39
#, python-brace-format
msgid "unknown language '{code}'; valid codes are: {valid}"
msgstr "onbekende taal '{code}'; geldige codes zijn: {valid}"

#. Translators: heading above the list of selectable interface languages.
#: src/pyguibud/cli.py:47
msgid "Available interface languages (* marks the active one):"
msgstr "Beschikbare interfacetalen (* markeert de actieve taal):"

#: src/pyguibud/cli.py:53
#, python-brace-format
msgid ""
"The pseudo-locale {code} is also accepted; it is meant for testing "
"layouts."
msgstr ""
"De pseudo-landinstelling {code} wordt ook geaccepteerd; deze is bedoeld "
"om indelingen te testen."

#: src/pyguibud/cli.py:89
msgid "PyGUIbud: drag-and-drop GUI builder for Python."
msgstr "PyGUIbud: GUI-builder voor Python met slepen en neerzetten."

#: src/pyguibud/cli.py:96 src/pyguibud/uic.py:73
msgid "show the version number and exit"
msgstr "het versienummer tonen en afsluiten"

#: src/pyguibud/cli.py:103 src/pyguibud/uic.py:80
msgid "interface language code, for example de_DE or en_XA"
msgstr "taalcode van de interface, bijvoorbeeld de_DE of en_XA"

#: src/pyguibud/cli.py:108
msgid "list the available interface languages and exit"
msgstr "de beschikbare interfacetalen weergeven en afsluiten"

#. Translators: {default} is the --theme value used by default (light),
#. inserted as it
#. is: the option accepts only the untranslated names shown in its list of
#. choices.
#: src/pyguibud/cli.py:117
#, python-brace-format
msgid "designer colour theme (default: the last one used, else {default})"
msgstr ""
"kleurthema van de ontwerper (standaard: het laatst gebruikte, anders "
"{default})"

#. Translators: the safe-mode option; plugins are widget packages installed
#. separately.
#: src/pyguibud/cli.py:125
msgid "start without loading any plugin (safe mode)"
msgstr "starten zonder plug-ins te laden (veilige modus)"

#: src/pyguibud/cli.py:132
msgid "a .ui file to open"
msgstr "een te openen .ui-bestand"

#: src/pyguibud/cli.py:150 src/pyguibud/designer/files.py:61
#: src/pyguibud/uic.py:51
msgid "Network and device paths cannot be opened."
msgstr "Netwerk- en apparaatpaden kunnen niet worden geopend."

#. Translators: {path} is the file named on the command line.
#. Translators: {path} is the full path of a file.
#: src/pyguibud/cli.py:153 src/pyguibud/designer/app.py:103
#, python-brace-format
msgid "The file '{path}' does not exist."
msgstr "Het bestand '{path}' bestaat niet."

#. Translators: {count} is the number of validation errors, {path} the .ui file
#. name.
#: src/pyguibud/codegen/_errors.py:13
#, python-brace-format
msgid "{count} error prevents generating code from '{path}'."
msgid_plural "{count} errors prevent generating code from '{path}'."
msgstr[0] "Door {count} fout kan er geen code worden gegenereerd uit '{path}'."
msgstr[1] "Door {count} fouten kan er geen code worden gegenereerd uit '{path}'."

#. Translators: {path} is the .ui file name, {version} a PyGUIbud version
#. number.
#: src/pyguibud/codegen/_errors.py:18
#, python-brace-format
msgid ""
"'{path}' was written by a newer PyGUIbud ({version}); update PyGUIbud to "
"generate code from it."
msgstr ""
"'{path}' is geschreven door een nieuwere versie van PyGUIbud ({version});"
" werk PyGUIbud bij om er code uit te genereren."

#. Translators: {src} is a file path written in a .ui file, {path} the .ui
#. file; {force} is a
#. command-line option; keep it unchanged.
#: src/pyguibud/codegen/_errors.py:24
#, python-brace-format
msgid ""
"The path '{src}' used by '{path}' is absolute or outside the folder of "
"its .ui file; use {force} to generate code from it anyway."
msgstr ""
"Het pad '{src}' dat '{path}' gebruikt, is absoluut of ligt buiten de map "
"van het .ui-bestand; gebruik {force} om er toch code uit te genereren."

#. Translators: {path} is the .ui file name.
#: src/pyguibud/codegen/_errors.py:28
#, python-brace-format
msgid "'{path}' has no main window or dialog to generate code for."
msgstr ""
"'{path}' bevat geen hoofdvenster of dialoogvenster om code voor te "
"genereren."

#. Translators: {name} is an identifier taken from a .ui file.
#: src/pyguibud/codegen/_errors.py:30
#, python-brace-format
msgid "Code generation stopped: '{name}' is not a safe Python name."
msgstr "Het genereren van code is gestopt: '{name}' is geen veilige Python-naam."

#. Translators: {src} is the relative path of an image file named in the .ui
#. file.
#: src/pyguibud/codegen/_errors.py:32
#, python-brace-format
msgid ""
"The image file '{src}' changed or is no longer valid; check the file "
"again."
msgstr ""
"Het afbeeldingsbestand '{src}' is gewijzigd of is niet meer geldig; "
"controleer het bestand opnieuw."

#. Translators: {path} is the .ui file name, {output} the Python file that
#. would be written.
#: src/pyguibud/codegen/_errors.py:35
#, python-brace-format
msgid ""
"The translations of '{path}' are looked for in 'locale' next to "
"'{output}', because the two files are on different drives."
msgstr ""
"De vertalingen van '{path}' worden gezocht in 'locale' naast '{output}', "
"omdat de twee bestanden op verschillende stations staan."

#. Translators: {output} is the Python file that would be written.
#: src/pyguibud/codegen/_errors.py:39
#, python-brace-format
msgid "'{output}' is a .ui file of this interface; choose another output file."
msgstr ""
"'{output}' is een .ui-bestand van deze interface; kies een ander "
"uitvoerbestand."

#. Translators: {output} is the Python file that would be written; {program} is
#. the name of the
#. command and {force} one of its options; keep both unchanged.
#: src/pyguibud/codegen/_errors.py:43
#, python-brace-format
msgid ""
"'{output}' was not generated by {program}; it is not replaced (use "
"{force} to replace it)."
msgstr ""
"'{output}' is niet gegenereerd door {program}; het wordt niet vervangen "
"(gebruik {force} om het te vervangen)."

#. Translators: {output} is the file that cannot be written, {reason} the
#. system's explanation.
#: src/pyguibud/codegen/_errors.py:46
#, python-brace-format
msgid "'{output}' cannot be written: {reason}"
msgstr "'{output}' kan niet worden geschreven: {reason}"

#. Translators: {output} is the file the extraction would write; {force} is a
#. command-line
#. option; keep it unchanged.
#: src/pyguibud/codegen/_errors.py:50
#, python-brace-format
msgid ""
"'{output}' is a translation catalogue (a .po file or a file with "
"translations); it is not replaced (use {force} to replace it)."
msgstr ""
"'{output}' is een vertaalcatalogus (een .po-bestand of een bestand met "
"vertalingen); het wordt niet vervangen (gebruik {force} om het te "
"vervangen)."

#. Translators: {output} is the output file named on the command line or
#. derived from a .ui file.
#: src/pyguibud/codegen/_errors.py:55
#, python-brace-format
msgid ""
"'{output}' is a folder, a device or a reserved device name; choose "
"another output file."
msgstr ""
"'{output}' is een map, een apparaat of een gereserveerde apparaatnaam; "
"kies een ander uitvoerbestand."

#. Translators: {output} is the output file; on Windows a ':' after the drive
#. names a hidden
#. "alternate data stream" of another file (a.py:evil), never a file of its
#. own.
#: src/pyguibud/codegen/_errors.py:60
#, python-brace-format
msgid ""
"'{output}' contains ':', which Windows would write into a hidden part of "
"another file; choose another output file."
msgstr ""
"'{output}' bevat ':', wat Windows in een verborgen deel van een ander "
"bestand zou schrijven; kies een ander uitvoerbestand."

#. Translators: {output} is the Python file that would be written; {option} is
#. a command-line
#. option; keep it unchanged.
#: src/pyguibud/codegen/_errors.py:66
#, python-brace-format
msgid ""
"'{output}' was already written from another .ui file in this run; rename "
"one of the .ui files or generate it alone with {option}."
msgstr ""
"'{output}' is in deze uitvoering al geschreven vanuit een ander .ui-"
"bestand; hernoem een van de .ui-bestanden of genereer het afzonderlijk "
"met {option}."

#: src/pyguibud/core/commands.py:91
#, python-brace-format
msgid ""
"This document was opened read-only (schema version {version}); it cannot "
"be changed."
msgstr ""
"Dit document is alleen-lezen geopend (schemaversie {version}); het kan "
"niet worden gewijzigd."

#: src/pyguibud/core/commands.py:93
msgid "This element does not belong to the open document."
msgstr "Dit element hoort niet bij het geopende document."

#. Translators: {detail} is the reason the file writer gives, already
#. translated.
#: src/pyguibud/core/commands.py:96
#, python-brace-format
msgid ""
"This change would make the document impossible to save, so it was not "
"applied: {detail}"
msgstr ""
"Deze wijziging zou het document onmogelijk op te slaan maken en is daarom"
" niet toegepast: {detail}"

#: src/pyguibud/core/commands.py:98
msgid "Undo or redo failed; the document was left as it was."
msgstr ""
"Ongedaan maken of opnieuw uitvoeren is mislukt; het document is "
"ongewijzigd gelaten."

#. Translators: {id} is a variable id; {user} the id of an element that is
#. bound to it.
#: src/pyguibud/core/commands.py:101
msgid ""
"Undo or redo failed and the document may have changed; the undo history "
"was cleared."
msgstr ""
"Ongedaan maken of opnieuw uitvoeren is mislukt en het document is "
"mogelijk gewijzigd; de geschiedenis is gewist."

#: src/pyguibud/core/commands.py:103
#, python-brace-format
msgid "The variable '{id}' is still used by '{user}'; unbind it first."
msgstr ""
"De variabele '{id}' wordt nog gebruikt door '{user}'; verbreek eerst de "
"koppeling."

#. Translators: {id} is an image resource id; {user} the id of an element that
#. shows it.
#: src/pyguibud/core/commands.py:106
#, python-brace-format
msgid ""
"The image resource '{id}' is still used by '{user}'; remove that use "
"first."
msgstr ""
"De afbeeldingsresource '{id}' wordt nog gebruikt door '{user}'; verwijder"
" dat gebruik eerst."

#: src/pyguibud/core/commands.py:260
msgid "Edit"
msgstr "Bewerken"

#: src/pyguibud/core/commands.py:305
msgid "Add element"
msgstr "Element toevoegen"

#: src/pyguibud/core/commands.py:355
msgid "Delete element"
msgstr "Element verwijderen"

#: src/pyguibud/core/commands.py:374
#, python-brace-format
msgid "'{node}' has already been removed."
msgstr "'{node}' is al verwijderd."

#: src/pyguibud/core/commands.py:391 src/pyguibud/core/commands.py:887
#: src/pyguibud/designer/editing.py:96
msgid "Move element"
msgstr "Element verplaatsen"

#: src/pyguibud/core/commands.py:463
msgid "Set property"
msgstr "Eigenschap instellen"

#: src/pyguibud/core/commands.py:508
msgid "Remove property"
msgstr "Eigenschap verwijderen"

#: src/pyguibud/core/commands.py:553 src/pyguibud/core/commands.py:609
msgid "Change attribute"
msgstr "Attribuut wijzigen"

#: src/pyguibud/core/commands.py:660
msgid "Change events"
msgstr "Gebeurtenissen wijzigen"

#: src/pyguibud/core/commands.py:733
msgid "Set variable"
msgstr "Variabele instellen"

#: src/pyguibud/core/commands.py:752
msgid "Remove variable"
msgstr "Variabele verwijderen"

#: src/pyguibud/core/commands.py:779
msgid "Set image resource"
msgstr "Afbeeldingsresource instellen"

#: src/pyguibud/core/commands.py:798
msgid "Remove image resource"
msgstr "Afbeeldingsresource verwijderen"

#: src/pyguibud/core/commands.py:917 src/pyguibud/designer/editing.py:527
msgid "Change layout"
msgstr "Indeling wijzigen"

#: src/pyguibud/core/files.py:78
msgid "it is not a regular file"
msgstr "het is geen gewoon bestand"

#: src/pyguibud/core/files.py:79
msgid "it cannot be read"
msgstr "het kan niet worden gelezen"

#: src/pyguibud/core/files.py:80
msgid "it is larger than 16 MiB"
msgstr "het is groter dan 16 MiB"

#: src/pyguibud/core/files.py:81
msgid "its content does not match its file type"
msgstr "de inhoud komt niet overeen met het bestandstype"

#: src/pyguibud/core/files.py:82
msgid "its header is damaged"
msgstr "de koptekst is beschadigd"

#: src/pyguibud/core/files.py:83
msgid "it is wider or taller than 4096 pixels"
msgstr "het is breder of hoger dan 4096 pixels"

#: src/pyguibud/core/files.py:84
msgid "its data is incomplete or damaged"
msgstr "de gegevens zijn onvolledig of beschadigd"

#: src/pyguibud/core/files.py:85
msgid "plain-text PPM/PGM is not supported; save it as binary PPM/PGM or PNG"
msgstr ""
"PPM/PGM in platte tekst wordt niet ondersteund; sla het op als binair "
"PPM/PGM of als PNG"

#. Translators: {version} and {current} are schema versions such as 1.0.
#: src/pyguibud/core/migrations/__init__.py:59
#, python-brace-format
msgid "Schema version {version} cannot be upgraded to {current}."
msgstr "Schemaversie {version} kan niet worden bijgewerkt naar {current}."

#. Translators: {version} is a schema version; {result} is what the upgrade
#. produced instead of a valid newer version.
#: src/pyguibud/core/migrations/__init__.py:73
#, python-brace-format
msgid ""
"The upgrade from schema version {version} failed: it produced version "
"'{result}'."
msgstr ""
"De upgrade van schemaversie {version} is mislukt: het resultaat was "
"versie '{result}'."

#. Translators: {name} is the class name found in the file.
#: src/pyguibud/core/model.py:133 src/pyguibud/core/validate.py:367
#: src/pyguibud/core/xml_io.py:894 src/pyguibud/core/xml_io.py:1520
#, python-brace-format
msgid "'{name}' is not a valid widget class name."
msgstr "'{name}' is geen geldige widgetklassenaam."

#: src/pyguibud/core/model.py:405
#, python-brace-format
msgid "{node} already has a parent; remove it first."
msgstr "{node} heeft al een bovenliggend element; verwijder het eerst."

#: src/pyguibud/core/model.py:412
#, python-brace-format
msgid "{node} cannot be placed inside itself or one of its descendants."
msgstr ""
"{node} kan niet in zichzelf of in een van de onderliggende elementen "
"worden geplaatst."

#: src/pyguibud/core/model.py:418
#, python-brace-format
msgid "{child} cannot be a child of {parent}."
msgstr "{child} kan geen onderliggend element van {parent} zijn."

#: src/pyguibud/core/model.py:442
#, python-brace-format
msgid "{node} is not a child of {parent}."
msgstr "{node} is geen onderliggend element van {parent}."

#: src/pyguibud/core/model.py:750
#, python-brace-format
msgid "The enumeration property '{name}' has no choices."
msgstr "De opsommingseigenschap '{name}' heeft geen keuzes."

#: src/pyguibud/core/model.py:752
#, python-brace-format
msgid "The default of property '{name}' is not one of its choices."
msgstr "De standaardwaarde van eigenschap '{name}' is niet een van de keuzes."

#: src/pyguibud/core/model.py:754
#, python-brace-format
msgid "Only enumeration properties may have choices ('{name}')."
msgstr "Alleen opsommingseigenschappen mogen keuzes hebben ('{name}')."

#: src/pyguibud/core/model.py:756
#, python-brace-format
msgid "Only string properties can be translatable ('{name}')."
msgstr "Alleen tekenreekseigenschappen kunnen vertaalbaar zijn ('{name}')."

#: src/pyguibud/core/model.py:764
#, python-brace-format
msgid "Only string properties can have a pattern or a maximum length ('{name}')."
msgstr ""
"Alleen tekenreekseigenschappen kunnen een patroon of een maximale lengte "
"hebben ('{name}')."

#: src/pyguibud/core/model.py:767
#, python-brace-format
msgid "The maximum length of property '{name}' must be a whole number."
msgstr "De maximale lengte van eigenschap '{name}' moet een geheel getal zijn."

#: src/pyguibud/core/model.py:769
#, python-brace-format
msgid "The maximum length of property '{name}' is out of range."
msgstr "De maximale lengte van eigenschap '{name}' valt buiten het bereik."

#: src/pyguibud/core/model.py:773
#, python-brace-format
msgid "The pattern of property '{name}' is not a valid regular expression."
msgstr "Het patroon van eigenschap '{name}' is geen geldige reguliere expressie."

#: src/pyguibud/core/registry.py:68
#, python-brace-format
msgid ""
"The factory of widget '{name}' from '{distribution}' for backend "
"'{backend}' could not be imported: {error}"
msgstr ""
"De factory van widget '{name}' uit '{distribution}' voor backend "
"'{backend}' kon niet worden geïmporteerd: {error}"

#: src/pyguibud/core/registry.py:72
#, python-brace-format
msgid ""
"The factory of widget '{name}' from '{distribution}' failed to create the"
" widget with backend '{backend}': {error}"
msgstr ""
"De factory van widget '{name}' uit '{distribution}' kon de widget niet "
"maken met backend '{backend}': {error}"

#: src/pyguibud/core/registry.py:76
#, python-brace-format
msgid ""
"The factory of widget '{name}' from '{distribution}' returned an unusable"
" widget with backend '{backend}': {error}"
msgstr ""
"De factory van widget '{name}' uit '{distribution}' leverde een "
"onbruikbare widget op met backend '{backend}': {error}"

#: src/pyguibud/core/registry.py:80
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' could not be set up with "
"backend '{backend}': {error}"
msgstr ""
"De widget '{name}' uit '{distribution}' kon niet worden ingesteld met "
"backend '{backend}': {error}"

#: src/pyguibud/core/registry.py:268
#, python-brace-format
msgid "The backend '{name}' from '{distribution}' is already registered."
msgstr "De backend '{name}' uit '{distribution}' is al geregistreerd."

#: src/pyguibud/core/registry.py:289
#, python-brace-format
msgid "The plugin '{distribution}' is disabled and was not loaded."
msgstr "De plug-in '{distribution}' is uitgeschakeld en is niet geladen."

#: src/pyguibud/core/registry.py:305
#, python-brace-format
msgid "The entry points of group '{group}' could not be read: {error}"
msgstr "De entry points van groep '{group}' konden niet worden gelezen: {error}"

#: src/pyguibud/core/registry.py:357
#, python-brace-format
msgid ""
"The entry point '{entry_point}' from '{distribution}' does not provide a "
"widget specification, an iterable of them or a callable returning them."
msgstr ""
"Het entry point '{entry_point}' uit '{distribution}' levert geen "
"widgetspecificatie, geen iterabel daarvan en geen aanroepbaar object dat "
"ze teruggeeft."

#: src/pyguibud/core/registry.py:370
#, python-brace-format
msgid ""
"The entry point '{entry_point}' from '{distribution}' failed to load: "
"{error}"
msgstr ""
"Het entry point '{entry_point}' uit '{distribution}' kon niet worden "
"geladen: {error}"

#: src/pyguibud/core/registry.py:383
#, python-brace-format
msgid ""
"The entry point '{entry_point}' from '{distribution}' provided an item "
"that is not a widget specification: {item}"
msgstr ""
"Het entry point '{entry_point}' uit '{distribution}' leverde een item op "
"dat geen widgetspecificatie is: {item}"

#: src/pyguibud/core/registry.py:396
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' targets widget API version "
"{version}, but this version of PyGUIbud requires version {required}."
msgstr ""
"De widget '{name}' uit '{distribution}' is bedoeld voor widget-API-versie"
" {version}, maar deze versie van PyGUIbud vereist versie {required}."

#: src/pyguibud/core/registry.py:411
#, python-brace-format
msgid "The widget class name '{name}' from '{distribution}' is not valid."
msgstr "De widgetklassenaam '{name}' uit '{distribution}' is niet geldig."

#: src/pyguibud/core/registry.py:420
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' has no prefix; plugin widgets "
"need a prefixed name such as 'acme:{name}' and cannot replace core "
"widgets."
msgstr ""
"De widget '{name}' uit '{distribution}' heeft geen voorvoegsel; plug-"
"inwidgets hebben een naam met voorvoegsel nodig, zoals 'acme:{name}', en "
"kunnen kernwidgets niet vervangen."

#: src/pyguibud/core/registry.py:431
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' uses the prefix '{prefix}', "
"which is reserved for PyGUIbud's own widgets; it was ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' gebruikt het voorvoegsel "
"'{prefix}', dat is gereserveerd voor de eigen widgets van PyGUIbud; de "
"widget is genegeerd."

#: src/pyguibud/core/registry.py:443
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' has an invalid factory "
"({factory}) and was ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' heeft een ongeldige factory "
"({factory}) en is genegeerd."

#: src/pyguibud/core/registry.py:457
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' has no display name and was "
"ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' heeft geen weergavenaam en is "
"genegeerd."

#: src/pyguibud/core/registry.py:467
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' is already registered by "
"'{first}' and was ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' is al geregistreerd door "
"'{first}' en is genegeerd."

#. Translators: {declared} is the plugin name a widget claims; {distribution}
#. is the package it really comes from, which PyGUIbud uses instead.
#: src/pyguibud/core/registry.py:488
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' declares the plugin "
"'{declared}'; '{distribution}' is used instead."
msgstr ""
"De widget '{name}' van '{distribution}' geeft de plug-in '{declared}' op;"
" in plaats daarvan wordt '{distribution}' gebruikt."

#: src/pyguibud/core/registry.py:518
#, python-brace-format
msgid "The built-in widgets could not be loaded: {error}"
msgstr "De ingebouwde widgets konden niet worden geladen: {error}"

#: src/pyguibud/core/registry.py:534
#, python-brace-format
msgid ""
"Built-in widgets were missing from the installed package metadata and "
"were registered directly: {names}. Reinstalling PyGUIbud may fix this."
msgstr ""
"Ingebouwde widgets ontbraken in de metagegevens van het geïnstalleerde "
"pakket en zijn rechtstreeks geregistreerd: {names}. Opnieuw installeren "
"van PyGUIbud kan dit verhelpen."

#: src/pyguibud/core/registry.py:555
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' has no valid core fallback "
"class ('{fallback}') and was ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' heeft geen geldige kernklasse als"
" terugvaloptie ('{fallback}') en is genegeerd."

#: src/pyguibud/core/registry.py:561
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' and its fallback '{fallback}' "
"disagree on whether they are containers; the widget was ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' en de terugvaloptie '{fallback}' "
"verschillen in de vraag of ze containers zijn; de widget is genegeerd."

#: src/pyguibud/core/registry.py:570
#, python-brace-format
msgid ""
"The widget '{name}' from '{distribution}' supports events or variable "
"types that its fallback '{fallback}' does not; the widget was ignored."
msgstr ""
"De widget '{name}' uit '{distribution}' ondersteunt gebeurtenissen of "
"variabeletypen die de terugvaloptie '{fallback}' niet ondersteunt; de "
"widget is genegeerd."

#: src/pyguibud/core/registry.py:792 src/pyguibud/preview/_host.py:22
#, python-brace-format
msgid "Unknown backend '{name}'."
msgstr "Onbekende backend '{name}'."

#: src/pyguibud/core/registry.py:797
#, python-brace-format
msgid "The backend '{name}' from '{distribution}' failed to load: {error}"
msgstr "De backend '{name}' uit '{distribution}' kon niet worden geladen: {error}"

#: src/pyguibud/core/registry.py:813
#, python-brace-format
msgid "Unknown widget class '{name}'."
msgstr "Onbekende widgetklasse '{name}'."

#. Translators: the property of a window that holds the text of its title bar.
#: src/pyguibud/core/validate.py:144
msgid "Title"
msgstr "Titel"

#. Translators: {id} is an element id from the file, {first} the path of the
#. first element.
#: src/pyguibud/core/validate.py:196
#, python-brace-format
msgid "The id '{id}' is used more than once; the first use is {first}."
msgstr "De id '{id}' wordt meer dan eens gebruikt; het eerste gebruik is {first}."

#: src/pyguibud/core/validate.py:197
msgid "This element has no id; every element needs a unique id."
msgstr "Dit element heeft geen id; elk element heeft een unieke id nodig."

#. Translators: {id} is the text found in the file, {limit} a whole number.
#: src/pyguibud/core/validate.py:200
#, python-brace-format
msgid ""
"'{id}' is not a valid id: use up to {limit} letters (a–z, A–Z), digits "
"and underscores, starting with a letter."
msgstr ""
"'{id}' is geen geldige id: gebruik maximaal {limit} letters (a–z, A–Z), "
"cijfers en onderstrepingstekens, beginnend met een letter."

#: src/pyguibud/core/validate.py:203
#, python-brace-format
msgid "'{id}' is a Python keyword and cannot be used as an id."
msgstr "'{id}' is een Python-sleutelwoord en kan niet als id worden gebruikt."

#. Translators: {first} is the path of the first main window.
#: src/pyguibud/core/validate.py:205
#, python-brace-format
msgid "Only one window can be the main window; {first} already is."
msgstr "Slechts één venster kan het hoofdvenster zijn; {first} is dat al."

#: src/pyguibud/core/validate.py:206
msgid "The document has no windows."
msgstr "Het document bevat geen vensters."

#: src/pyguibud/core/validate.py:208
#, python-brace-format
msgid "The component window '{id}' cannot have a menu bar or a status bar."
msgstr "Het componentvenster '{id}' kan geen menubalk of statusbalk hebben."

#. Translators: {attribute} is an attribute name such as modal; {id} is an
#. element id.
#: src/pyguibud/core/validate.py:211
#, python-brace-format
msgid "'{attribute}' only applies to dialog windows and is ignored on '{id}'."
msgstr ""
"'{attribute}' is alleen van toepassing op dialoogvensters en wordt "
"genegeerd bij '{id}'."

#. Translators: {field} is a property or attribute name; the other values are
#. numbers.
#: src/pyguibud/core/validate.py:213
#, python-brace-format
msgid "{field} must be between {minimum} and {maximum}, not {value}."
msgstr "{field} moet tussen {minimum} en {maximum} liggen, niet {value}."

#: src/pyguibud/core/validate.py:214
#, python-brace-format
msgid "{field} must be at least {minimum}, not {value}."
msgstr "{field} moet minimaal {minimum} zijn, niet {value}."

#: src/pyguibud/core/validate.py:215
#, python-brace-format
msgid "{field} must be at most {maximum}, not {value}."
msgstr "{field} mag maximaal {maximum} zijn, niet {value}."

#. Translators: {parent} and {id} are element ids, {class_name} a widget class
#. name.
#: src/pyguibud/core/validate.py:218
#, python-brace-format
msgid ""
"'{parent}' ({class_name}) cannot contain other widgets; move '{id}' into "
"a container."
msgstr ""
"'{parent}' ({class_name}) kan geen andere widgets bevatten; verplaats "
"'{id}' naar een container."

#: src/pyguibud/core/validate.py:221
#, python-brace-format
msgid "'{id}' ({class_name}) is not a container and cannot have a layout."
msgstr "'{id}' ({class_name}) is geen container en kan geen indeling hebben."

#: src/pyguibud/core/validate.py:224
#, python-brace-format
msgid ""
"'{id}' ({class_name}) shows its children as pages and cannot have a "
"layout."
msgstr ""
"'{id}' ({class_name}) toont de onderliggende elementen als pagina's en "
"kan geen indeling hebben."

#: src/pyguibud/core/validate.py:226
#, python-brace-format
msgid "'{id}' has no layout; add a grid or a pack layout."
msgstr "'{id}' heeft geen indeling; voeg een grid- of pack-indeling toe."

#. Translators: {expected} is a placement tag such as <cell>; keep it
#. untranslated.
#: src/pyguibud/core/validate.py:228
#, python-brace-format
msgid "'{id}' needs a {expected} placement inside '{parent}'."
msgstr "'{id}' heeft een plaatsing {expected} nodig binnen '{parent}'."

#. Translators: {found} and {expected} are placement tags such as <cell>,
#. <pack> or <page>.
#: src/pyguibud/core/validate.py:231
#, python-brace-format
msgid "'{id}' has a {found} placement, but '{parent}' expects {expected}."
msgstr "'{id}' heeft een plaatsing {found}, maar '{parent}' verwacht {expected}."

#: src/pyguibud/core/validate.py:234
#, python-brace-format
msgid "'{id}' overlaps '{other}' in the grid at row {row}, column {column}."
msgstr "'{id}' overlapt '{other}' in het grid op rij {row}, kolom {column}."

#. Translators: n, s, e and w are the compass letters of the Tk sticky option;
#. keep them as they are.
#: src/pyguibud/core/validate.py:238
#, python-brace-format
msgid ""
"'{value}' is not a valid sticky value; use any of n, s, e and w, each at "
"most once."
msgstr ""
"'{value}' is geen geldige sticky-waarde; gebruik n, s, e en w in "
"willekeurige combinatie, elk hoogstens één keer."

#: src/pyguibud/core/validate.py:240
msgid "A pack layout cannot configure grid columns or rows."
msgstr "Een pack-indeling kan geen grid-kolommen of -rijen configureren."

#: src/pyguibud/core/validate.py:241
#, python-brace-format
msgid "Grid column {index} is configured more than once."
msgstr "Grid-kolom {index} is meer dan eens geconfigureerd."

#: src/pyguibud/core/validate.py:242
#, python-brace-format
msgid "Grid row {index} is configured more than once."
msgstr "Grid-rij {index} is meer dan eens geconfigureerd."

#: src/pyguibud/core/validate.py:243
msgid "'orient' only applies to pack layouts and is ignored here."
msgstr ""
"'orient' is alleen van toepassing op pack-indelingen en wordt hier "
"genegeerd."

#. Translators: {attribute} is an attribute name such as weight; {class_name} a
#. widget class name.
#: src/pyguibud/core/validate.py:245
#, python-brace-format
msgid "'{attribute}' of a page is ignored by {class_name}."
msgstr "'{attribute}' van een pagina wordt genegeerd door {class_name}."

#: src/pyguibud/core/validate.py:247
#, python-brace-format
msgid "'{class_name}' is a menu or window element and cannot be used as a widget."
msgstr ""
"'{class_name}' is een menu- of vensterelement en kan niet als widget "
"worden gebruikt."

#. Translators: {limit} is a whole number of nesting levels.
#: src/pyguibud/core/validate.py:250
#, python-brace-format
msgid "'{id}' is nested too deeply; a .ui file allows at most {limit} levels."
msgstr ""
"'{id}' is te diep genest; een .ui-bestand staat hoogstens {limit} niveaus"
" toe."

#: src/pyguibud/core/validate.py:251
#, python-brace-format
msgid "Unknown widget class '{class_name}'."
msgstr "Onbekende widgetklasse '{class_name}'."

#: src/pyguibud/core/validate.py:253
#, python-brace-format
msgid "The extension widget '{id}' ({class_name}) needs a fallback core class."
msgstr ""
"De uitbreidingswidget '{id}' ({class_name}) heeft een kernklasse als "
"terugvaloptie nodig."

#: src/pyguibud/core/validate.py:256
#, python-brace-format
msgid ""
"'{fallback}' is not a core widget class and cannot be the fallback of "
"'{id}'."
msgstr ""
"'{fallback}' is geen kernwidgetklasse en kan niet de terugvaloptie van "
"'{id}' zijn."

#: src/pyguibud/core/validate.py:259
#, python-brace-format
msgid ""
"The fallback '{fallback}' of '{id}' does not match {class_name}: one is a"
" container and the other is not."
msgstr ""
"De terugvaloptie '{fallback}' van '{id}' past niet bij {class_name}: de "
"ene is een container en de andere niet."

#. Translators: {command} is the literal install command ("pip install" and a
#. package name); keep
#. it unchanged.
#: src/pyguibud/core/validate.py:265
#, python-brace-format
msgid ""
"'{class_name}' is not installed, so '{fallback}' is shown instead; "
"install it with: {command}"
msgstr ""
"'{class_name}' is niet geïnstalleerd, dus '{fallback}' wordt in plaats "
"daarvan getoond; installeer het met: {command}"

#: src/pyguibud/core/validate.py:268
#, python-brace-format
msgid "'{class_name}' is not installed, so '{fallback}' is shown instead."
msgstr ""
"'{class_name}' is niet geïnstalleerd, dus '{fallback}' wordt in plaats "
"daarvan getoond."

#. Translators: {plugin} is a distribution name; "Help ▸ Plugins" is the menu
#. path.
#: src/pyguibud/core/validate.py:272
#, python-brace-format
msgid ""
"'{class_name}' comes from '{plugin}', which failed to load, so "
"'{fallback}' is shown instead. See Help ▸ Plugins."
msgstr ""
"'{class_name}' is afkomstig van '{plugin}', dat niet kon worden geladen, "
"dus '{fallback}' wordt in plaats daarvan getoond. Zie Help ▸ Plug-ins."

#: src/pyguibud/core/validate.py:276
#, python-brace-format
msgid ""
"'{class_name}' comes from '{plugin}', which is disabled, so '{fallback}' "
"is shown instead. See Help ▸ Plugins."
msgstr ""
"'{class_name}' is afkomstig van '{plugin}', dat is uitgeschakeld, dus "
"'{fallback}' wordt in plaats daarvan getoond. Zie Help ▸ Plug-ins."

#: src/pyguibud/core/validate.py:279
#, python-brace-format
msgid "'{plugin}' on '{id}' is not a valid distribution name."
msgstr "'{plugin}' bij '{id}' is geen geldige distributienaam."

#. Translators: "bootstyle" is a ttkbootstrap term; keep it untranslated.
#: src/pyguibud/core/validate.py:282
#, python-brace-format
msgid ""
"The bootstyle '{value}' of '{id}' is not valid: use lower-case words "
"joined by '-' or spaces, at most {limit} characters."
msgstr ""
"De bootstyle '{value}' van '{id}' is ongeldig: gebruik woorden in kleine "
"letters, verbonden met '-' of spaties, hoogstens {limit} tekens."

#: src/pyguibud/core/validate.py:285
#, python-brace-format
msgid "The bootstyle '{value}' of '{id}' has the unknown word '{token}'."
msgstr "De bootstyle '{value}' van '{id}' bevat het onbekende woord '{token}'."

#: src/pyguibud/core/validate.py:286
#, python-brace-format
msgid "{class_name} has no bootstyle; the one on '{id}' is ignored."
msgstr "{class_name} heeft geen bootstyle; die bij '{id}' wordt genegeerd."

#. Translators: {package} is the package name ttkbootstrap, inserted as it is.
#: src/pyguibud/core/validate.py:289
#, python-brace-format
msgid ""
"The attribute '{name}' on '{id}' is not a {package} attribute; it is kept"
" but ignored."
msgstr ""
"Het attribuut '{name}' bij '{id}' is geen {package}-attribuut; het blijft"
" bewaard maar wordt genegeerd."

#. Translators: {hint} describes the expected format and is already translated.
#: src/pyguibud/core/validate.py:292
#, python-brace-format
msgid "The value of '{prop}' on '{id}' is not valid: {hint}"
msgstr "De waarde van '{prop}' bij '{id}' is ongeldig: {hint}"

#: src/pyguibud/core/validate.py:293
#, python-brace-format
msgid "The value of '{prop}' on '{id}' is not valid."
msgstr "De waarde van '{prop}' bij '{id}' is ongeldig."

#: src/pyguibud/core/validate.py:295
#, python-brace-format
msgid ""
"The value of '{prop}' on '{id}' has {length} characters; at most {limit} "
"are allowed."
msgstr ""
"De waarde van '{prop}' bij '{id}' bevat {length} tekens; hoogstens "
"{limit} zijn toegestaan."

#: src/pyguibud/core/validate.py:298
#, python-brace-format
msgid "'{attribute}' only applies to extension widgets and is ignored on '{id}'."
msgstr ""
"'{attribute}' is alleen van toepassing op uitbreidingswidgets en wordt "
"genegeerd bij '{id}'."

#: src/pyguibud/core/validate.py:300
#, python-brace-format
msgid "{class_name} has no property '{name}'; it is kept but ignored."
msgstr ""
"{class_name} heeft geen eigenschap '{name}'; deze blijft bewaard maar "
"wordt genegeerd."

#. Translators: {name} is a property name and {value} the text found in the
#. file.
#: src/pyguibud/core/validate.py:302
#, python-brace-format
msgid "The property '{name}' must be a whole number, not '{value}'."
msgstr "De eigenschap '{name}' moet een geheel getal zijn, niet '{value}'."

#: src/pyguibud/core/validate.py:303
#, python-brace-format
msgid "The property '{name}' must be a number, not '{value}'."
msgstr "De eigenschap '{name}' moet een getal zijn, niet '{value}'."

#. Translators: keep true and false untranslated.
#: src/pyguibud/core/validate.py:305
#, python-brace-format
msgid "The property '{name}' must be true or false, not '{value}'."
msgstr "De eigenschap '{name}' moet true of false zijn, niet '{value}'."

#. Translators: {choices} is a comma-separated list of the allowed values.
#: src/pyguibud/core/validate.py:307
#, python-brace-format
msgid "The property '{name}' must be one of {choices}, not '{value}'."
msgstr "De eigenschap '{name}' moet een van {choices} zijn, niet '{value}'."

#: src/pyguibud/core/validate.py:309
#, python-brace-format
msgid ""
"The property '{name}' must be a colour such as #1a2b3c or a colour name, "
"not '{value}'."
msgstr ""
"De eigenschap '{name}' moet een kleur zijn, zoals #1a2b3c of een "
"kleurnaam, niet '{value}'."

#. Translators: {value} is a name such as SystemButtonFace; keep #1a2b3c as it
#. is.
#: src/pyguibud/core/validate.py:313
#, python-brace-format
msgid ""
"The property '{name}' uses '{value}', a system colour that exists on one "
"platform only; use a colour such as #1a2b3c or a colour name."
msgstr ""
"De eigenschap '{name}' gebruikt '{value}', een systeemkleur die slechts "
"op één platform bestaat; gebruik een kleur zoals #1a2b3c of een "
"kleurnaam."

#: src/pyguibud/core/validate.py:316
#, python-brace-format
msgid "The property '{name}' cannot be translatable."
msgstr "De eigenschap '{name}' kan niet vertaalbaar zijn."

#: src/pyguibud/core/validate.py:318
#, python-brace-format
msgid ""
"The image property '{name}' must refer to an image resource (and have no "
"text)."
msgstr ""
"De afbeeldingseigenschap '{name}' moet naar een afbeeldingsresource "
"verwijzen (en geen tekst hebben)."

#: src/pyguibud/core/validate.py:321
#, python-brace-format
msgid "The property '{name}' is not an image and cannot refer to a resource."
msgstr ""
"De eigenschap '{name}' is geen afbeelding en kan niet naar een resource "
"verwijzen."

#: src/pyguibud/core/validate.py:323
#, python-brace-format
msgid "'{ref}' is not a declared image resource."
msgstr "'{ref}' is geen gedeclareerde afbeeldingsresource."

#. Translators: {events} is a comma-separated list of event names and
#. "key:<sequence>"; keep it
#. unchanged.
#: src/pyguibud/core/validate.py:326
#, python-brace-format
msgid "'{name}' is not a valid event; use one of: {events}."
msgstr "'{name}' is geen geldige gebeurtenis; gebruik een van: {events}."

#: src/pyguibud/core/validate.py:328
#, python-brace-format
msgid "{class_name} does not support the event '{name}'."
msgstr "{class_name} ondersteunt de gebeurtenis '{name}' niet."

#: src/pyguibud/core/validate.py:329
#, python-brace-format
msgid "The event '{name}' is handled more than once on '{id}'."
msgstr "De gebeurtenis '{name}' wordt meer dan eens afgehandeld bij '{id}'."

#: src/pyguibud/core/validate.py:331
#, python-brace-format
msgid ""
"'{handler}' is not a valid handler name: use letters, digits and "
"underscores, starting with a letter, and no Python keyword."
msgstr ""
"'{handler}' is geen geldige naam voor een gebeurtenishandler: gebruik "
"letters, cijfers en onderstrepingstekens, beginnend met een letter, en "
"geen Python-sleutelwoord."

#: src/pyguibud/core/validate.py:334
#, python-brace-format
msgid "'{bind}' is not a valid variable name."
msgstr "'{bind}' is geen geldige variabelenaam."

#: src/pyguibud/core/validate.py:335
#, python-brace-format
msgid "'{bind}' is not a declared variable."
msgstr "'{bind}' is geen gedeclareerde variabele."

#: src/pyguibud/core/validate.py:336
#, python-brace-format
msgid "{class_name} cannot be bound to a variable."
msgstr "{class_name} kan niet aan een variabele worden gekoppeld."

#. Translators: {type} is a variable type (string, int, double or bool);
#. {allowed} a list of them.
#: src/pyguibud/core/validate.py:339
#, python-brace-format
msgid ""
"{class_name} cannot be bound to the {type} variable '{bind}'; use one of:"
" {allowed}."
msgstr ""
"{class_name} kan niet worden gekoppeld aan de variabele '{bind}' van het "
"type {type}; gebruik een van: {allowed}."

#: src/pyguibud/core/validate.py:342
#, python-brace-format
msgid ""
"The default '{default}' of the variable '{id}' is not a valid {type} "
"value."
msgstr ""
"De standaardwaarde '{default}' van de variabele '{id}' is geen geldige "
"waarde van het type {type}."

#. Translators: {length} and {limit} are numbers of characters.
#: src/pyguibud/core/validate.py:346
#, python-brace-format
msgid ""
"The property '{name}' has {length} characters; at most {limit} are "
"allowed."
msgstr ""
"De eigenschap '{name}' bevat {length} tekens; hoogstens {limit} zijn "
"toegestaan."

#: src/pyguibud/core/validate.py:349
#, python-brace-format
msgid ""
"The default of the variable '{id}' has {length} characters; at most "
"{limit} are allowed."
msgstr ""
"De standaardwaarde van de variabele '{id}' bevat {length} tekens; "
"hoogstens {limit} zijn toegestaan."

#: src/pyguibud/core/validate.py:351
#, python-brace-format
msgid "'{id}' has no file path."
msgstr "'{id}' heeft geen bestandspad."

#: src/pyguibud/core/validate.py:352
#, python-brace-format
msgid "The path '{path}' is absolute; use a path relative to the .ui file."
msgstr ""
"Het pad '{path}' is absoluut; gebruik een pad ten opzichte van het .ui-"
"bestand."

#: src/pyguibud/core/validate.py:353
#, python-brace-format
msgid "The path '{path}' points outside the folder of the .ui file."
msgstr "Het pad '{path}' wijst naar een locatie buiten de map van het .ui-bestand."

#. Translators: {path} is a file path written in the .ui file.
#: src/pyguibud/core/validate.py:356
#, python-brace-format
msgid ""
"The path '{path}' points to a network share or a device, which is never "
"opened; use a path relative to the .ui file."
msgstr ""
"Het pad '{path}' wijst naar een netwerkshare of een apparaat, dat nooit "
"wordt geopend; gebruik een pad ten opzichte van het .ui-bestand."

#: src/pyguibud/core/validate.py:359
#, python-brace-format
msgid "'{component}' is not a valid component id."
msgstr "'{component}' is geen geldige component-id."

#. Translators: {where} is a technical path; {codepoint} a hexadecimal
#. character code such as 0001.
#: src/pyguibud/core/validate.py:362
#, python-brace-format
msgid ""
"{where} contains the character U+{codepoint}, which a .ui file cannot "
"store."
msgstr ""
"{where} bevat het teken U+{codepoint}, dat een .ui-bestand niet kan "
"opslaan."

#. Translators: {field} is an attribute name such as kind; {choices} is a
#. comma-separated list of
#. the allowed values and {value} the value found.
#: src/pyguibud/core/validate.py:366
#, python-brace-format
msgid "{field} must be one of {choices}, not '{value}'."
msgstr "{field} moet een van {choices} zijn, niet '{value}'."

#. Translators: {where} is a technical path such as window[main]@buttons.
#: src/pyguibud/core/validate.py:369
#, python-brace-format
msgid "{where} must be text, not '{value}'."
msgstr "{where} moet tekst zijn, niet '{value}'."

#. Translators: {field} is an attribute name such as modal; keep true and false
#. untranslated.
#: src/pyguibud/core/validate.py:371
#, python-brace-format
msgid "{field} must be true or false, not '{value}'."
msgstr "{field} moet true of false zijn, niet '{value}'."

#: src/pyguibud/core/validate.py:372
msgid "The text of a page must be a property named 'text'."
msgstr "De tekst van een pagina moet een eigenschap met de naam 'text' zijn."

#. Translators: {name} is an XML attribute name; {where} is a technical path
#. such as
#. window[main]/widget[btn]/prop[text].
#: src/pyguibud/core/validate.py:375
#, python-brace-format
msgid "'{name}' is not a valid extra attribute name for {where}."
msgstr "'{name}' is geen geldige naam voor een extra attribuut van {where}."

#. Translators: {where} is a technical path such as
#. window[main]/widget[btn]/cell.
#: src/pyguibud/core/validate.py:377
#, python-brace-format
msgid "The preserved XML content of {where} is damaged and cannot be saved."
msgstr ""
"De bewaarde XML-inhoud van {where} is beschadigd en kan niet worden "
"opgeslagen."

#. Translators: {where} is a technical path; {value} the value found;
#. {expected} is the name of a
#. model type such as Event or GridLine (keep it untranslated).
#: src/pyguibud/core/validate.py:380
#, python-brace-format
msgid "{where} contains '{value}', which is not a {expected}."
msgstr "{where} bevat '{value}', dat geen {expected} is."

#. Translators: {version} is the version stored in the document, {current} the
#. one PyGUIbud saves.
#: src/pyguibud/core/validate.py:383
#, python-brace-format
msgid "The schema version '{version}' cannot be saved; it must be {current}."
msgstr ""
"De schemaversie '{version}' kan niet worden opgeslagen; deze moet "
"{current} zijn."

#: src/pyguibud/core/validate.py:386
#, python-brace-format
msgid "'{id}' is reserved by the generated interface and cannot be used as an id."
msgstr ""
"'{id}' is gereserveerd door de gegenereerde interface en kan niet als id "
"worden gebruikt."

#. Translators: {value} is the text from the file, {choices} a list of button
#. names.
#: src/pyguibud/core/validate.py:390
#, python-brace-format
msgid ""
"'{value}' is not a valid button list; use a comma-separated list of "
"{choices} without repeats."
msgstr ""
"'{value}' is geen geldige knoppenlijst; gebruik een door komma's "
"gescheiden lijst van {choices} zonder herhalingen."

#. Translators: {value} is the shortcut as typed in the file; {example} and
#. {other} are valid
#. shortcuts (Ctrl+S, Ctrl+Shift+F5), inserted as they are: a file must use
#. these key names.
#: src/pyguibud/core/validate.py:394
#, python-brace-format
msgid "'{value}' is not a valid shortcut, for example {example} or {other}."
msgstr "'{value}' is geen geldige sneltoets, bijvoorbeeld {example} of {other}."

#. Translators: {value} is the shortcut as typed in the file; {first} and
#. {last} are key names
#. (F1, F24) and {ctrl} and {alt} modifier names (Ctrl, Alt), inserted as they
#. are.
#: src/pyguibud/core/validate.py:399
#, python-brace-format
msgid ""
"The shortcut '{value}' needs {ctrl} or {alt} unless it is a function key "
"({first}–{last})."
msgstr ""
"De sneltoets '{value}' heeft {ctrl} of {alt} nodig, tenzij het een "
"functietoets is ({first}–{last})."

#. Translators: {value} is the key sequence as typed in the file; {example} and
#. {other} are valid
#. key events (key:Ctrl+S, key:<Control-s>), inserted as they are: a file must
#. use these names.
#: src/pyguibud/core/validate.py:407
#, python-brace-format
msgid "'{value}' is not a valid key, for example {example} or {other}."
msgstr "'{value}' is geen geldige toets, bijvoorbeeld {example} of {other}."

#. Translators: {shortcut} is a shortcut such as Ctrl+S, {window} a window id.
#: src/pyguibud/core/validate.py:411
#, python-brace-format
msgid ""
"The shortcut '{shortcut}' is used more than once in '{window}'; only the "
"first one works."
msgstr ""
"De sneltoets '{shortcut}' wordt meer dan eens gebruikt in '{window}'; "
"alleen de eerste werkt."

#: src/pyguibud/core/validate.py:413
#, python-brace-format
msgid "'{src}' is not a supported image; use PNG, GIF, PPM or PGM."
msgstr "'{src}' is geen ondersteunde afbeelding; gebruik PNG, GIF, PPM of PGM."

#: src/pyguibud/core/validate.py:414
#, python-brace-format
msgid "The image file '{src}' does not exist."
msgstr "Het afbeeldingsbestand '{src}' bestaat niet."

#. Translators: {src} is a file path, {reason} says what is wrong with the
#. file.
#: src/pyguibud/core/validate.py:416
#, python-brace-format
msgid "The image file '{src}' cannot be used: {reason}"
msgstr "Het afbeeldingsbestand '{src}' kan niet worden gebruikt: {reason}"

#: src/pyguibud/core/validate.py:418
#, python-brace-format
msgid ""
"The value '{value}' of '{id}' must be a whole number, because it is bound"
" to the int variable '{bind}'."
msgstr ""
"De waarde '{value}' van '{id}' moet een geheel getal zijn, omdat deze is "
"gekoppeld aan de int-variabele '{bind}'."

#: src/pyguibud/core/validate.py:422
#, python-brace-format
msgid ""
"'{value}' is not a valid translation domain; use letters, digits, '_', "
"'-' or '.'."
msgstr ""
"'{value}' is geen geldig vertaaldomein; gebruik letters, cijfers, '_', "
"'-' of '.'."

#. Translators: {value} is the source language attribute of a .ui file.
#: src/pyguibud/core/validate.py:426
#, python-brace-format
msgid ""
"'{value}' is not a valid language code for the source texts; use a code "
"such as en_GB."
msgstr ""
"'{value}' is geen geldige taalcode voor de brontekst; gebruik een code "
"zoals en_GB."

#: src/pyguibud/core/validate.py:428
#, python-brace-format
msgid "The included file '{src}' does not exist or cannot be read."
msgstr "Het ingesloten bestand '{src}' bestaat niet of kan niet worden gelezen."

#. Translators: {src} is the path of an included file; {count} is its number of
#. errors.
#: src/pyguibud/core/validate.py:431
#, python-brace-format
msgid "The included file '{src}' has {count} error."
msgid_plural "The included file '{src}' has {count} errors."
msgstr[0] "Het ingesloten bestand '{src}' bevat {count} fout."
msgstr[1] "Het ingesloten bestand '{src}' bevat {count} fouten."

#. Translators: {reason} is the cause, for example "The file is not valid UTF-8
#. text".
#: src/pyguibud/core/validate.py:435
#, python-brace-format
msgid "The included file '{src}' cannot be read: {reason}"
msgstr "Het ingesloten bestand '{src}' kan niet worden gelezen: {reason}"

#: src/pyguibud/core/validate.py:436
#, python-brace-format
msgid "'{src}' has no component window '{component}'."
msgstr "'{src}' bevat geen componentvenster '{component}'."

#: src/pyguibud/core/validate.py:437
#, python-brace-format
msgid "The window '{component}' in '{src}' is not a component."
msgstr "Het venster '{component}' in '{src}' is geen component."

#. Translators: {chain} is a path such as a.ui#x -> b.ui#y -> a.ui#x.
#: src/pyguibud/core/validate.py:439
#, python-brace-format
msgid "Including '{component}' from '{src}' creates a cycle: {chain}."
msgstr ""
"Het insluiten van '{component}' uit '{src}' veroorzaakt een cyclus: "
"{chain}."

#: src/pyguibud/core/validate.py:440
#, python-brace-format
msgid "Including '{src}' nests includes deeper than {limit} levels."
msgstr "Het insluiten van '{src}' nestelt insluitingen dieper dan {limit} niveaus."

#: src/pyguibud/core/validate.py:441
#, python-brace-format
msgid "Including '{src}' reads more than {limit} files."
msgstr "Het insluiten van '{src}' leest meer dan {limit} bestanden."

#: src/pyguibud/core/validate.py:442
#, python-brace-format
msgid "Including '{src}' creates more than {limit} widgets."
msgstr "Het insluiten van '{src}' maakt meer dan {limit} widgets aan."

#. Translators: {count} is the number of problems left out of a list that was
#. cut short.
#: src/pyguibud/core/validate.py:445
#, python-brace-format
msgid "{count} more problem was found but not listed."
msgid_plural "{count} more problems were found but not listed."
msgstr[0] "Er is nog {count} probleem gevonden dat niet is weergegeven."
msgstr[1] "Er zijn nog {count} problemen gevonden die niet zijn weergegeven."


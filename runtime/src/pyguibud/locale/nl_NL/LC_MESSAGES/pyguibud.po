#: src/pyguibud/core/xml_io.py:160
msgid "This is a folder, not a .ui file."
msgstr "Dit is een map, geen .ui-bestand."

#: src/pyguibud/core/xml_io.py:165
msgid "This is a device or another special file, not a .ui file."
msgstr "Dit is een apparaat of een ander speciaal bestand, geen .ui-bestand."

#: src/pyguibud/core/xml_io.py:173
msgid "The file does not exist."
msgstr "Het bestand bestaat niet."

#. Translators: {reason} is an error description from the operating system.
#: src/pyguibud/core/xml_io.py:179
#, python-brace-format
msgid "The file could not be read: {reason}"
msgstr "Het bestand kon niet worden gelezen: {reason}"

#: src/pyguibud/core/xml_io.py:204
msgid "The file is not valid UTF-8 text; save it with UTF-8 encoding."
msgstr "Het bestand is geen geldige UTF-8-tekst; sla het op met UTF-8-codering."

#. Translators: {namespace} is the XML namespace URI of PyGUIbud files.
#: src/pyguibud/core/xml_io.py:218
#, python-brace-format
msgid ""
"This is not a PyGUIbud .ui file: the root element must be <pyguibud-ui> "
"in the namespace {namespace}."
msgstr ""
"Dit is geen PyGUIbud .ui-bestand: het hoofdelement moet <pyguibud-ui> "
"zijn in de naamruimte {namespace}."

#. Translators: {limit} is a whole number of mebibytes.
#: src/pyguibud/core/xml_io.py:230 src/pyguibud/core/xml_io.py:1134
#, python-brace-format
msgid "The file is larger than the limit of {limit} MiB for .ui files."
msgstr "Het bestand is groter dan de limiet van {limit} MiB voor .ui-bestanden."

#. Translators: {element} is an XML element name, {attribute} an attribute
#. name.
#: src/pyguibud/core/xml_io.py:266 src/pyguibud/core/xml_io.py:519
#, python-brace-format
msgid "The element <{element}> needs the attribute '{attribute}'."
msgstr "Het element <{element}> vereist het attribuut '{attribute}'."

#. Translators: {version} is the text found in the file; keep MAJOR.MINOR as it
#. is.
#: src/pyguibud/core/xml_io.py:278
#, python-brace-format
msgid ""
"'{version}' is not a valid schema version; expected MAJOR.MINOR, for "
"example 1.0."
msgstr ""
"'{version}' is geen geldige schemaversie; verwacht wordt MAJOR.MINOR, "
"bijvoorbeeld 1.0."

#. Translators: {version} and {current} are schema versions such as 2.0 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:290
#, python-brace-format
msgid ""
"This file uses schema version {version}; it needs a newer PyGUIbud (this "
"one supports {current})."
msgstr ""
"Dit bestand gebruikt schemaversie {version}; er is een nieuwere versie "
"van PyGUIbud nodig (deze ondersteunt {current})."

#. Translators: {version} and {current} are schema versions such as 1.1 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:308
#, python-brace-format
msgid ""
"This file uses schema version {version}, newer than {current}; it is "
"opened read-only so that nothing is lost."
msgstr ""
"Dit bestand gebruikt schemaversie {version}, nieuwer dan {current}; het "
"wordt alleen-lezen geopend zodat er niets verloren gaat."

#. Translators: {version} and {current} are schema versions such as 0.9 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:324
#, python-brace-format
msgid ""
"The file was upgraded from schema version {version} to {current}; saving "
"writes the new version."
msgstr ""
"Het bestand is bijgewerkt van schemaversie {version} naar {current}; bij "
"het opslaan wordt de nieuwe versie geschreven."

#. Translators: {prefix} is an XML namespace prefix such as tb; {uri} is the
#. namespace it is bound to in the file. Keep both unchanged.
#: src/pyguibud/core/xml_io.py:342
#, python-brace-format
msgid ""
"The prefix '{prefix}' is bound to the foreign namespace '{uri}'; this "
"content is not for ttkbootstrap and is saved under another prefix."
msgstr ""
"Het voorvoegsel '{prefix}' is gekoppeld aan de vreemde naamruimte "
"'{uri}'; deze inhoud is niet voor ttkbootstrap en wordt onder een ander "
"voorvoegsel opgeslagen."

#. Translators: {count} is a number of XML comments and processing
#. instructions.
#: src/pyguibud/core/xml_io.py:359
#, python-brace-format
msgid ""
"Comments and processing instructions ({count}) are not kept when the file"
" is saved."
msgstr ""
"Opmerkingen en verwerkingsinstructies ({count}) worden niet bewaard "
"wanneer het bestand wordt opgeslagen."

#. Translators: {element} is an XML element name.
#: src/pyguibud/core/xml_io.py:421
#, python-brace-format
msgid "Text is not allowed directly inside <{element}>."
msgstr "Tekst is niet toegestaan rechtstreeks binnen <{element}>."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:442
#, python-brace-format
msgid ""
"Unknown element <{element}> inside <{parent}> is kept as it is; check its"
" spelling."
msgstr ""
"Het onbekende element <{element}> binnen <{parent}> blijft ongewijzigd "
"bewaard; controleer de spelling."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:455
#, python-brace-format
msgid "<{element}> is not allowed inside <{parent}>."
msgstr "<{element}> is niet toegestaan binnen <{parent}>."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:464
#, python-brace-format
msgid ""
"<{element}> inside <{parent}> belongs to a newer schema and is kept as it"
" is."
msgstr ""
"<{element}> binnen <{parent}> hoort bij een nieuwer schema en blijft "
"ongewijzigd bewaard."

#. Translators: {element} and {parent} are XML element names.
#: src/pyguibud/core/xml_io.py:481
#, python-brace-format
msgid "<{element}> appears more than once inside <{parent}>."
msgstr "<{element}> komt meer dan eens voor binnen <{parent}>."

#. Translators: {attribute} is an XML attribute name, {element} an element.
#: src/pyguibud/core/xml_io.py:504
#, python-brace-format
msgid ""
"Unknown attribute '{attribute}' on <{element}> is kept as it is; check "
"its spelling."
msgstr ""
"Het onbekende attribuut '{attribute}' bij <{element}> blijft ongewijzigd "
"bewaard; controleer de spelling."

#. Translators: {attribute} is an attribute name, {element} an element name and
#. {value} the text found in the file.
#: src/pyguibud/core/xml_io.py:533
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be a whole number, not "
"'{value}'."
msgstr ""
"Het attribuut '{attribute}' van <{element}> moet een geheel getal zijn, "
"niet '{value}'."

#. Translators: {attribute} is an attribute name, {element} an element name and
#. {value} the text found in the file; keep true and false untranslated.
#: src/pyguibud/core/xml_io.py:570
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be true or false, not "
"'{value}'."
msgstr ""
"Het attribuut '{attribute}' van <{element}> moet true of false zijn, niet"
" '{value}'."

#. Translators: {attribute} is an attribute name, {element} an element name,
#. {choices} a comma-separated list of allowed values and {value} the text
#. found.
#: src/pyguibud/core/xml_io.py:600
#, python-brace-format
msgid ""
"The attribute '{attribute}' of <{element}> must be one of {choices}, not "
"'{value}'."
msgstr ""
"Het attribuut '{attribute}' van <{element}> moet een van {choices} zijn, "
"niet '{value}'."

#. Translators: {id} is an identifier from the file.
#: src/pyguibud/core/xml_io.py:671
#, python-brace-format
msgid "The resource id '{id}' is declared more than once."
msgstr "De resource-id '{id}' is meer dan eens gedeclareerd."

#. Translators: {id} is an identifier from the file.
#: src/pyguibud/core/xml_io.py:700
#, python-brace-format
msgid "The variable id '{id}' is declared more than once."
msgstr "De variabele-id '{id}' is meer dan eens gedeclareerd."

#. Translators: {name} is a property name.
#: src/pyguibud/core/xml_io.py:723
#, python-brace-format
msgid "The property '{name}' must contain plain text only, not elements."
msgstr "De eigenschap '{name}' mag alleen platte tekst bevatten, geen elementen."

#. Translators: {name} is a property name, {element} an XML element name.
#: src/pyguibud/core/xml_io.py:750
#, python-brace-format
msgid "The property '{name}' is set more than once on <{element}>."
msgstr "De eigenschap '{name}' is meer dan eens ingesteld bij <{element}>."

#. Translators: {element} is an XML element name; keep <cell>, <pack> and
#. <page>.
#: src/pyguibud/core/xml_io.py:950
#, python-brace-format
msgid "<{element}> has more than one placement (<cell>, <pack> or <page>)."
msgstr "<{element}> heeft meer dan één plaatsing (<cell>, <pack> of <page>)."

#. Translators: {name} is a property name; keep 'text' untranslated.
#: src/pyguibud/core/xml_io.py:1001
#, python-brace-format
msgid "A <page> can only hold the property 'text', not '{name}'."
msgstr "Een <page> kan alleen de eigenschap 'text' bevatten, niet '{name}'."

#. Translators: {reason} is an error description from the operating system.
#: src/pyguibud/core/xml_io.py:1071
#, python-brace-format
msgid "The file could not be saved: {reason}"
msgstr "Het bestand kon niet worden opgeslagen: {reason}"

#. Translators: {version} and {current} are schema versions such as 1.1 and
#. 1.0.
#: src/pyguibud/core/xml_io.py:1108
#, python-brace-format
msgid ""
"This document uses schema version {version}, newer than {current}; it was"
" opened read-only and cannot be saved."
msgstr ""
"Dit document gebruikt schemaversie {version}, nieuwer dan {current}; het "
"is alleen-lezen geopend en kan niet worden opgeslagen."

#. Translators: {version} is the version stored in the document, {current} the
#. version this PyGUIbud writes.
#: src/pyguibud/core/xml_io.py:1120
#, python-brace-format
msgid ""
"The document's schema version '{version}' cannot be saved; expected "
"{current}."
msgstr ""
"De schemaversie '{version}' van het document kan niet worden opgeslagen; "
"verwacht wordt {current}."

#. Translators: {where} is a technical path such as window[main]@kind; {value}
#. is
#. the offending value.
#: src/pyguibud/core/xml_io.py:1155
#, python-brace-format
msgid "{where} has the value '{value}', which the .ui format cannot store."
msgstr "{where} heeft de waarde '{value}', die het .ui-formaat niet kan opslaan."

#. Translators: {where} is a technical path; {key} and {name} are identifiers.
#: src/pyguibud/core/xml_io.py:1199
#, python-brace-format
msgid "{where}: the key '{key}' does not match the name '{name}'."
msgstr "{where}: de sleutel '{key}' komt niet overeen met de naam '{name}'."

#. Translators: {limit} is a number of nesting levels.
#: src/pyguibud/core/xml_io.py:1219 src/pyguibud/core/xml_io.py:1265
#: src/pyguibud/core/xmltree.py:263
#, python-brace-format
msgid "Elements are nested more than {limit} levels deep."
msgstr "Elementen zijn dieper dan {limit} niveaus genest."

#. Translators: {name} is an XML attribute name; {where} is a technical path.
#: src/pyguibud/core/xml_io.py:1232 src/pyguibud/core/xmltree.py:152
#, python-brace-format
msgid "'{name}' is not a valid attribute name here ({where})."
msgstr "'{name}' is hier geen geldige attribuutnaam ({where})."

#: src/pyguibud/core/xml_io.py:1247
msgid "RawXml.extra_attrs must be empty"
msgstr "RawXml.extra_attrs moet leeg zijn"

#. Translators: {element} is an XML element name.
#: src/pyguibud/core/xml_io.py:1258
#, python-brace-format
msgid "<{element}> is a .ui element and cannot be kept as preserved XML"
msgstr ""
"<{element}> is een .ui-element en kan niet als bewaarde XML worden "
"behouden"

#. Translators: {where} is a technical path; {detail} explains the damage.
#: src/pyguibud/core/xml_io.py:1274 src/pyguibud/core/xmltree.py:383
#, python-brace-format
msgid "Preserved XML content of {where} is damaged: {detail}"
msgstr "De bewaarde XML-inhoud van {where} is beschadigd: {detail}"

#. Translators: {where} is a technical path such as
#. window[main]/widget[btn]@text;
#. {codepoint} is a hexadecimal character code such as 0001.
#: src/pyguibud/core/xmltree.py:141
#, python-brace-format
msgid "{where} contains the character U+{codepoint}, which XML cannot store."
msgstr "{where} bevat het teken U+{codepoint}, dat XML niet kan opslaan."

#. Translators: {prefix} is an XML namespace prefix, {uri} its namespace URI.
#: src/pyguibud/core/xmltree.py:186
#, python-brace-format
msgid "The namespace declaration '{prefix}' = '{uri}' is not valid."
msgstr "De naamruimtedeclaratie '{prefix}' = '{uri}' is ongeldig."

#. Translators: {element} is an XML element name; {attribute} is the literal
#. XML
#. attribute to remove; keep it unchanged.
#: src/pyguibud/core/xmltree.py:281
#, python-brace-format
msgid ""
"The element <{element}> has no namespace; remove {attribute} from the "
"file."
msgstr ""
"Het element <{element}> heeft geen naamruimte; verwijder {attribute} uit "
"het bestand."

#. Translators: {encoding} is an encoding name such as ISO-8859-1.
#: src/pyguibud/core/xmltree.py:328
#, python-brace-format
msgid "The file declares the encoding '{encoding}'; only UTF-8 is supported."
msgstr ""
"Het bestand declareert de codering '{encoding}'; alleen UTF-8 wordt "
"ondersteund."

#: src/pyguibud/core/xmltree.py:335
msgid "DOCTYPE and entity declarations are not allowed in .ui files."
msgstr "DOCTYPE- en entiteitsdeclaraties zijn niet toegestaan in .ui-bestanden."

#. Translators: {detail} is an English description from the XML parser.
#: src/pyguibud/core/xmltree.py:345 src/pyguibud/core/xmltree.py:354
#, python-brace-format
msgid "The file is not well-formed XML: {detail}"
msgstr "Het bestand is geen goedgevormde XML: {detail}"

#: src/pyguibud/core/xmltree.py:399
msgid "it is not valid Unicode text"
msgstr "het is geen geldige Unicode-tekst"

#: src/pyguibud/core/xmltree.py:405
msgid "it contains comments or processing instructions"
msgstr "het bevat opmerkingen of verwerkingsinstructies"

#. Translators: {author} is a person's name and {tool} a product name; both are
#. never translated.
#: src/pyguibud/credits.py:10
#, python-brace-format
msgid "Created by {author} and programmed with the support of {tool}"
msgstr "Gemaakt door {author} en geprogrammeerd met de ondersteuning van {tool}"


msgstr "'{id}' ingevoegd."

#. Translators: {widget} is a palette item ("Button"); {key} is the key Enter,
#. inserted as it is
#. (key names are not translated).
#: src/pyguibud/designer/canvas/drag.py:67
#, python-brace-format
msgid ""
"Drag '{widget}' onto the canvas, or press {key} to insert it into the "
"selected container."
msgstr ""
"Sleep '{widget}' naar het tekenvlak, of druk op {key} om het in de "
"geselecteerde container in te voegen."

#: src/pyguibud/designer/canvas/drag.py:69
msgid "Menus and actions are edited in the menu editor."
msgstr "Menu's en acties worden bewerkt in de menueditor."


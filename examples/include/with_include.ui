<?xml version="1.0" encoding="UTF-8"?>
<pyguibud-ui schema_version="1.0" xmlns="urn:pyguibud:ui:1">
  <meta generator="pyguibud" source_locale="en_GB"/>
  <window id="main" kind="main">
    <prop name="title" translatable="true">Include example</prop>
    <layout type="grid" padding="12" gap="6">
      <column index="0" weight="1"/>
    </layout>
    <widget class="Label" id="lbl_heading">
      <prop name="text" translatable="true">Delivery address</prop>
      <cell row="0" column="0" sticky="w"/>
    </widget>
    <include id="inc_address" src="address_card.ui" component="address_card">
      <cell row="1" column="0" sticky="ew"/>
    </include>
    <widget class="Button" id="btn_ok">
      <prop name="text" translatable="true">OK</prop>
      <cell row="2" column="0" sticky="e"/>
    </widget>
  </window>
</pyguibud-ui>
